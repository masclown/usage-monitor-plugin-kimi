{
  "schemaVersion": 1,
  "minSdkVersion": "0.48.0",
  "providerId": "Kimi",
  "displayName": "Kimi",
  "meta": {
    "version": "1.1.0",
    "author": "UsageMonitor",
    "description": "Query Kimi membership usage (total / 5h / 7d windows, Chat/Code split, booster wallet, daily credit usage)",
    "iconUrl": "https://raw.githubusercontent.com/MoonshotAI/kimi-code/main/docs/.vitepress/theme/Kimi.png",
    "iconUrlDark": "https://raw.githubusercontent.com/MoonshotAI/kimi-code/main/docs/.vitepress/theme/Kimi.png"
  },
  "credentialDomains": [ "kimi.com", "www.kimi.com" ],
  "metadata": {
    "supportedBuckets": [ "second", "minute", "hour", "day", "week", "month" ],
    "fallbackBucket": "day",
    "supportedTables": [ 1, 2 ],
    "availableSlicerFields": [ "model_name", "channel", "request_status" ]
  },
  "loginConfig": {
    "loginUrl": "https://www.kimi.com/membership/subscription?tab=quota",
    "cookieDomainFilters": [ "kimi.com", "www.kimi.com" ],
    "loginTimeout": "00:03:00",
    "uiButtonText": "i18n:plugin.Kimi.login.button",
    "validateUrl": "https://www.kimi.com/membership/subscription?tab=quota",
    "requiredCookieDomain": "kimi.com",
    "loginUrlKeywords": [ "login", "signin", "sign-in", "passport" ],
    "loginSuccessHost": "www.kimi.com",
    "loggedInPathKeywords": [ "/membership", "/code", "/chat" ],
    "localStorageTokens": { "AccessToken": "access_token", "RefreshToken": "refresh_token" },
    "supportsHeadlessLogin": true
  },
  "configFields": [
    { "key": "ApiKey", "displayName": "i18n:plugin.Kimi.field.ApiKey.name", "fieldType": "Password", "isRequired": false, "placeholder": "i18n:plugin.Kimi.field.ApiKey.placeholder" }
  ],
  "errorGuidance": [
    { "matchCodes": [ "credential_missing", "config_missing" ], "matchKeywords": [], "message": "i18n:plugin.Kimi.guidance.credential" },
    { "matchCodes": [ "auth_invalid", "data_empty" ], "matchKeywords": [ "401", "REASON_INVALID_AUTH_TOKEN" ], "message": "i18n:plugin.Kimi.guidance.authInvalid" },
    { "matchKeywords": [], "message": "i18n:plugin.Kimi.guidance.fallback" }
  ],
  "usageUrls": {
    "zh-CN": "https://www.kimi.com/membership/subscription?tab=quota",
    "en-US": "https://www.kimi.com/membership/subscription?tab=quota"
  },
  "fetch": {
    "endpoints": [
      {
        "urlMatch": "GetSubscriptionStats",
        "mode": "http",
        "method": "POST",
        "urlTemplate": "https://www.kimi.com/apiv2/kimi.gateway.membership.v2.MembershipService/GetSubscriptionStats",
        "headers": {
          "Authorization": "Bearer {config:AccessToken}"
        },
        "bodyTemplate": "{}",
        "fields": [
          { "path": "$.subscriptionBalance.amountUsedRatio", "target": "total_used_percent", "transform": "parsePercent" },
          { "path": "$.subscriptionBalance.kimiCodeUsedRatio", "target": "code_used_percent", "transform": "parsePercent" },
          { "path": "$.subscriptionBalance.expireTime", "target": "quota_period_end_at", "transform": "toIso8601Utc" },
          { "path": "$.ratelimitCode5h.ratio", "target": "five_hour_used_percent", "transform": "parsePercent" },
          { "path": "$.ratelimitCode5h.resetTime", "target": "five_hour_reset_at", "transform": "parseDateTime" },
          { "path": "$.ratelimitCode7d.ratio", "target": "weekly_used_percent", "transform": "parsePercent" },
          { "path": "$.ratelimitCode7d.resetTime", "target": "weekly_reset_at", "transform": "parseDateTime" },
          { "path": "$.boosterWallets[0].moneyLeft.priceInCents", "target": "balance_amount", "transform": "centsToUnit" },
          { "path": "$.boosterWallets[0].moneyTotal.priceInCents", "target": "booster_total_amount", "transform": "centsToUnit" },
          { "path": "$.boosterWallets[0].monthlyUsed.priceInCents", "target": "monthly_cost", "transform": "centsToUnit" }
        ]
      },
      {
        "urlMatch": "GetSubscription",
        "mode": "http",
        "method": "POST",
        "urlTemplate": "https://www.kimi.com/apiv2/kimi.gateway.membership.v2.MembershipService/GetSubscription",
        "headers": {
          "Authorization": "Bearer {config:AccessToken}"
        },
        "bodyTemplate": "{}",
        "fields": [
          { "path": "$.subscription.goods.title", "target": "subscription_tier", "transform": "trim" },
          { "path": "$.subscription.goods.amounts[0].priceInCents", "target": "subscription_price", "transform": "centsToUnit" },
          { "path": "$.subscription.currentEndTime", "target": "subscription_end_at", "transform": "toIso8601Utc" }
        ]
      },
      {
        "urlMatch": "ListBalanceActions",
        "mode": "http",
        "method": "POST",
        "urlTemplate": "https://www.kimi.com/apiv2/kimi.gateway.membership.v2.MembershipService/ListBalanceActions",
        "headers": {
          "Authorization": "Bearer {config:AccessToken}",
          "connect-protocol-version": "1"
        },
        "bodyTemplate": "{\"page_size\":100,\"filter\":{\"unit\":\"UNIT_CREDIT\",\"balance_types\":[\"SUBSCRIPTION\"]}}",
        "pagination": {
          "mode": "nextToken",
          "nextTokenPath": "$.nextPageToken",
          "tokenParam": "page_token",
          "itemsProperty": "actions",
          "maxPages": 60,
          "maxPagesTemplate": "{config:MaxPages}"
        },
        "arrays": [
          {
            "itemsPath": "$.actions",
            "mode": "objects",
            "target": "request_detail",
            "itemFields": [
              { "path": "$.id", "target": "request_id", "transform": "trim" },
              { "path": "$.timestamp", "target": "occurred_at", "transform": "trim" },
              { "path": "$.feature", "target": "channel", "transform": "trim" },
              { "path": "$.feature", "target": "task_type", "transform": "trim" },
              { "path": "$.items[0].amountRatio", "target": "used_percent", "transform": "parsePercent" }
            ]
          }
        ]
      },
      {
        "urlMatch": "ListUnifiedRequests",
        "mode": "http",
        "method": "POST",
        "urlTemplate": "https://www.kimi.com/apiv2/kimi.gateway.code.v1.UsageService/ListUnifiedRequests",
        "headers": {
          "Authorization": "Bearer {config:AccessToken}"
        },
        "bodyTemplate": "{\"request_types\":[\"REQUEST_TYPE_SNAPSHOT\",\"REQUEST_TYPE_ERROR_REQUEST\"]}",
        "pagination": {
          "mode": "nextToken",
          "nextTokenPath": "$.nextPageToken",
          "tokenParam": "page_token",
          "itemsProperty": "unifiedRequests",
          "maxPages": 60,
          "maxPagesTemplate": "{config:MaxPages}"
        },
        "arrays": [
          {
            "itemsPath": "$.unifiedRequests",
            "mode": "objects",
            "target": "request_detail",
            "itemFields": [
              { "path": "$.requestId", "target": "request_id", "transform": "trim" },
              { "path": "$.requestTime", "target": "occurred_at", "transform": "trim" },
              { "path": "$.modelDisplayName", "target": "model_name", "transform": "trim" },
              { "path": "$.apiKey.name", "target": "channel", "transform": "trim" },
              { "path": "$.userAgent", "target": "request_client", "transform": "trim" },
              { "path": "$.httpStatusCode", "target": "request_status", "transform": "parseNumber" },
              { "path": "$.callType", "target": "task_type", "transform": "trim" }
            ]
          }
        ]
      }
    ],
    "computed": [
      { "target": "five_hour_used_percent", "op": "constant", "value": 0, "whenPresent": "five_hour_reset_at", "onlyIfAbsent": true },
      { "target": "chat_used_percent", "op": "subtract", "operands": [ "total_used_percent", "code_used_percent" ], "whenPresent": "total_used_percent" },
      { "target": "total_amount", "op": "constant", "value": 100, "whenPresent": "total_used_percent" },
      { "target": "booster_used_amount", "op": "subtract", "operands": [ "booster_total_amount", "balance_amount" ], "whenPresent": "booster_total_amount" },
      { "target": "total_cost", "op": "add", "operands": [ "subscription_price", "booster_used_amount" ], "whenPresent": "booster_used_amount" },
      { "target": "subscription_active", "op": "constant", "value": true, "whenPresent": "subscription_tier" },
      { "target": "today_used_count", "op": "sumRequestDetail", "column": "count", "window": "1d", "aggregate": "day" }
    ],
    "accountId": { "urlMatch": "GetSubscription", "path": "$.subscription.subscriptionId" }
  },
  "card": {
    "renderKinds": [ "subscriptionTitle", "summary", "charts" ],
    "primaryMetric": "total_used_percent",
    "collapseDividerIndex": 7,
    "trayTooltip": {
      "rows": [
        { "fieldName": "__provider_name__" },
        { "kind": "bar", "chartRef": "km.chart.quotaUsage" },
        { "fieldName": "__refresh_countdown__" }
      ]
    },
    "baseInfo": {
      "fields": [
        { "fieldName": "subscription_tier", "role": "Meta" },
        { "fieldName": "five_hour_reset_at", "role": "Reset" }
      ]
    },
    "charts": [
      // ===== Number 类型 =====
      {
        "chartId": "km.chart.overview",
        "display": "i18n:plugin.Kimi.chart.overview",
        "kind": "Number",
        "defaultOrder": 1,
        "tooltip": { "fields": [ "chat_used_percent", "code_used_percent", "balance_amount", "monthly_cost", "total_cost", "subscription_price" ] },
        "dataGroups": [
          { "id": "km.usage.chat", "display": "i18n:plugin.Kimi.group.chatUsage", "fields": [ { "fieldName": "chat_used_percent", "role": "Value" } ] },
          { "id": "km.usage.code", "display": "i18n:plugin.Kimi.group.codeUsage", "fields": [ { "fieldName": "code_used_percent", "role": "Value" } ] },
          { "id": "km.booster.balance", "display": "i18n:plugin.Kimi.group.boosterBalance", "defaultVisible": false, "fields": [ { "fieldName": "balance_amount", "role": "Value" } ] },
          { "id": "km.booster.monthly", "display": "i18n:plugin.Kimi.group.boosterMonthly", "defaultVisible": false, "fields": [ { "fieldName": "monthly_cost", "role": "Value" } ] },
          { "id": "km.cost.total", "display": "i18n:plugin.Kimi.group.totalCost", "defaultVisible": false, "fields": [ { "fieldName": "total_cost", "role": "Value" } ] },
          { "id": "km.price", "display": "i18n:plugin.Kimi.group.price", "defaultVisible": false, "fields": [ { "fieldName": "subscription_price", "role": "Value" } ] }
        ]
      },
      // ===== Bar 类型 =====
      {
        "chartId": "km.chart.quotaUsage",
        "display": "i18n:plugin.Kimi.chart.quotaUsage",
        "kind": "Bar",
        "defaultOrder": 2,
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "km.bar.5h" },
        "tooltip": {
          "fields": [
            "__field_name__",
            "five_hour_used_percent",
            "weekly_used_percent",
            "total_used_percent",
            "__refresh_countdown__"
          ]
        },
        "colorTiers": { "ref": "global:usage-tier-default" },
        "dataGroups": [
          {
            "id": "km.bar.5h",
            "display": "i18n:plugin.Kimi.group.fiveHourQuota",
            "fields": [
              { "fieldName": "five_hour_used_percent", "role": "Value" },
              { "fieldName": "five_hour_reset_at", "role": "Reset" }
            ]
          },
          {
            "id": "km.bar.weekly",
            "display": "i18n:plugin.Kimi.group.weeklyQuota",
            "fields": [
              { "fieldName": "weekly_used_percent", "role": "Value" },
              { "fieldName": "weekly_reset_at", "role": "Reset" }
            ]
          },
          {
            "id": "km.bar.total",
            "display": "i18n:plugin.Kimi.group.totalQuota",
            "fields": [
              { "fieldName": "total_used_percent", "role": "Value" },
              { "fieldName": "quota_period_end_at", "role": "Reset" }
            ]
          }
        ]
      },
      // ===== StackedBar 类型 =====
      {
        "chartId": "km.chart.dailyCredit",
        "display": "i18n:plugin.Kimi.chart.dailyCredit",
        "kind": "StackedBar",
        "defaultOrder": 4,
        "defaultVisible": false,
        "categoriesField": "daily_credit_categories",
        "seriesNamesField": "daily_credit_series_names",
        "valuesMatrixField": "daily_credit_matrix",
        "detailGroupBy": "channel",
        "detailValueField": "used_percent",
        "detailOp": "sum",
        "lookbackDays": 30,
        "slicer": { "mode": "Period", "default": "30d" },
        "seriesDisplayNames": {
          "FEATURE_CODING": "Code",
          "FEATURE_SWARM": "Agent Swarm",
          "FEATURE_CHAT": "K2.6"
        },
        "unit": "%",
        "colors": ["#1A88FF", "#FF810C", "#7C4DFF", "#00BFA5"],
        "dataGroups": [
          { "id": "km.dailyCredit", "display": "i18n:plugin.Kimi.group.dailyCreditFeature", "fields": [
            { "fieldName": "daily_credit_percent", "role": "Value" }
          ] }
        ]
      },
      {
        "chartId": "km.chart.requestStatusCount",
        "display": "i18n:plugin.Kimi.chart.requestStatusCount",
        "kind": "StackedBar",
        "defaultOrder": 5,
        "detailGroupBy": "request_status",
        "detailOp": "count",
        "detailValueField": "request_id",
        // 剔除无状态码流水（ListBalanceActions 无 httpStatusCode → request_status 为 NULL），只统计真实状态码。
        "excludeNullGroupValues": true,
        "unit": "i18n:plugin.Kimi.unit.count",
        "colors": ["#2ADB5C", "#F77234", "#FFC104", "#F14124"],
        "slicer": { "mode": "Period", "default": "1d" },
        "dataGroups": [
          {
            "id": "km.status.count",
            "display": "i18n:plugin.Kimi.group.requestStatusCount",
            "fields": [
              { "fieldName": "request_id", "role": "Value" }
            ]
          }
        ]
      },
      // ===== Curve 类型 =====
      {
        "chartId": "km.chart.creditTrend",
        "display": "i18n:plugin.Kimi.chart.creditTrend",
        "kind": "Curve",
        "defaultOrder": 6,
        "defaultVisible": false,
        "categoriesField": "daily_credit_categories",
        "seriesNamesField": "daily_credit_series_names",
        "valuesMatrixField": "daily_credit_matrix",
        "detailGroupBy": "channel",
        "detailValueField": "used_percent",
        "detailOp": "sum",
        "lookbackDays": 30,
        "slicer": { "mode": "Period", "default": "30d" },
        "seriesDisplayNames": {
          "FEATURE_CODING": "Code",
          "FEATURE_SWARM": "Agent Swarm",
          "FEATURE_CHAT": "K2.6"
        },
        "unit": "%",
        "colors": ["#1A88FF", "#FF810C", "#7C4DFF"],
        "dataGroups": [
          { "id": "km.dailyCredit", "display": "i18n:plugin.Kimi.group.dailyCreditFeature", "fields": [
            { "fieldName": "daily_credit_percent", "role": "Value" }
          ] }
        ]
      },
      // ===== HeatMap 类型（新增：当日用量百分比合计热力图）=====
      {
        "chartId": "km.chart.todayHeatmap",
        "display": "i18n:plugin.Kimi.chart.todayHeatmap",
        "kind": "HeatMap",
        "defaultOrder": 7,
        "defaultVisible": false,
        "detailGroupBy": "channel",
        "detailValueField": "used_percent",
        "detailOp": "sum",
        "lookbackDays": 90,
        "dataGroups": [
          {
            "id": "km.heatmap.dailyPercent",
            "display": "i18n:plugin.Kimi.group.dailyPercent",
            "fields": [
              { "fieldName": "daily_used_percent", "role": "Meta" },
              { "fieldName": "daily_credit_percent", "role": "Value" }
            ]
          }
        ]
      },
      // ===== StackedProgress 类型 =====
      {
        "chartId": "km.chart.usageSplit",
        "display": "i18n:plugin.Kimi.chart.usageSplit",
        "kind": "StackedProgress",
        "defaultOrder": 3,
        "unit": "%",
        "colors": ["#B8C4CE", "#1A88FF"],
        "tooltip": { "fields": [ "chat_used_percent", "code_used_percent", "total_used_percent" ] },
        "dataGroups": [
          {
            "id": "km.usageSplit",
            "fields": [
              { "fieldName": "chat_used_percent", "role": "Value" },
              { "fieldName": "code_used_percent", "role": "Value" },
              { "fieldName": "total_amount", "role": "Upper" },
              { "fieldName": "quota_period_end_at", "role": "Reset" }
            ]
          }
        ]
      },
      // ===== Curve 类型（snapshot 数据源） =====
      {
        "chartId": "km.chart.totalUsedTrend",
        "display": "i18n:plugin.Kimi.chart.totalUsedTrend",
        "kind": "Curve",
        "defaultOrder": 8,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": ["Last7Days", "Last15Days", "Last30Days"],
          "default": "Last30Days"
        },
        "tooltip": { "fields": ["__date__", "total_used_percent"] },
        "dataGroups": [{
          "id": "sdk.template.totalUsage",
          "fields": [
            { "fieldName": "recorded_at", "role": "Meta" },
            { "fieldName": "total_used_percent", "role": "Value" }
          ]
        }]
      },
      {
        "chartId": "km.chart.fiveHourUsedTrend",
        "display": "i18n:plugin.Kimi.chart.fiveHourUsedTrend",
        "kind": "Curve",
        "defaultOrder": 9,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": ["Last7Days", "Last15Days", "Last30Days"],
          "default": "Last30Days"
        },
        "tooltip": { "fields": ["__date__", "five_hour_used_percent"] },
        "dataGroups": [{
          "id": "sdk.template.quota5h",
          "fields": [
            { "fieldName": "recorded_at", "role": "Meta" },
            { "fieldName": "five_hour_used_percent", "role": "Value" }
          ]
        }]
      },
      {
        "chartId": "km.chart.weeklyUsedTrend",
        "display": "i18n:plugin.Kimi.chart.weeklyUsedTrend",
        "kind": "Curve",
        "defaultOrder": 10,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": ["Last7Days", "Last15Days", "Last30Days"],
          "default": "Last30Days"
        },
        "tooltip": { "fields": ["__date__", "weekly_used_percent"] },
        "dataGroups": [{
          "id": "sdk.template.quotaWeekly",
          "fields": [
            { "fieldName": "recorded_at", "role": "Meta" },
            { "fieldName": "weekly_used_percent", "role": "Value" }
          ]
        }]
      }
    ]
  },
  "taskbar": {
    "baseInfo": {
      "fields": [
        { "fieldName": "subscription_tier", "role": "Meta" },
        { "fieldName": "five_hour_reset_at", "role": "Reset" }
      ]
    },
    "miniCharts": [
      {
        "chartId": "km.mini.ring",
        "display": "i18n:plugin.Kimi.mini.ring",
        "kind": "MiniRingChart",
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "km.taskbar.5h" },
        "tooltip": {
          "fields": [
            "__provider_name__",
            "five_hour_used_percent",
            "weekly_used_percent",
            "total_used_percent",
            "today_used_count",
            "__refresh_countdown__"
          ]
        },
        "colorTiers": { "ref": "global:usage-tier-default" },
        "dataGroups": [
          { "id": "km.taskbar.5h", "display": "i18n:plugin.Kimi.group.taskbar5h", "fields": [ { "fieldName": "five_hour_used_percent", "role": "Value" } ] },
          { "id": "km.taskbar.weekly", "display": "i18n:plugin.Kimi.group.taskbarWeekly", "fields": [ { "fieldName": "weekly_used_percent", "role": "Value" } ] },
          { "id": "km.taskbar.total", "display": "i18n:plugin.Kimi.group.taskbarTotal", "fields": [ { "fieldName": "total_used_percent", "role": "Value" } ] },
          { "id": "km.taskbar.todayUsed", "display": "i18n:plugin.Kimi.group.taskbarTodayUsed", "fields": [ { "fieldName": "today_used_count", "role": "Value" } ] }
        ]
      },
      {
        "chartId": "km.mini.text",
        "display": "i18n:plugin.Kimi.mini.text",
        "kind": "MiniText",
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "km.taskbar.5h" },
        "tooltip": {
          "fields": [
            "__provider_name__",
            "five_hour_used_percent",
            "weekly_used_percent",
            "total_used_percent",
            "today_used_count",
            "__refresh_countdown__"
          ]
        },
        "dataGroups": [
          { "id": "km.taskbar.5h", "display": "i18n:plugin.Kimi.group.taskbar5h", "fields": [ { "fieldName": "five_hour_used_percent", "role": "Value" } ] },
          { "id": "km.taskbar.weekly", "display": "i18n:plugin.Kimi.group.taskbarWeekly", "fields": [ { "fieldName": "weekly_used_percent", "role": "Value" } ] },
          { "id": "km.taskbar.total", "display": "i18n:plugin.Kimi.group.taskbarTotal", "fields": [ { "fieldName": "total_used_percent", "role": "Value" } ] },
          { "id": "km.taskbar.todayUsed", "display": "i18n:plugin.Kimi.group.taskbarTodayUsed", "fields": [ { "fieldName": "today_used_count", "role": "Value" } ] }
        ]
      }
    ]
  }
}
