# ci-no-quality-gate: UsageMonitor 代码风格与命名约定
# 根配置：对所有项目提供 IDE 级提示；仅在开启 EnforceCodeStyleInBuild 的项目（Core）中参与构建门禁。
root = true

# ===== 通用 =====
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# ===== C# =====
[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf

# ---- 命名约定（warning 级：Core 构建中经 TreatWarningsAsErrors 阻塞） ----

# 命名规则违规诊断（IDE1006）在构建中报 warning（EnforceCodeStyleInBuild 项目生效）
dotnet_diagnostic.IDE1006.severity = warning

# 接口必须以 I 开头
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_begin_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_begin_with_i.style = prefix_i_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# 类型与公开成员使用 PascalCase
dotnet_naming_rule.types_pascal_case.severity = warning
dotnet_naming_rule.types_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_pascal_case.style = pascal_case_style
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate, method, property, event
dotnet_naming_symbols.type_symbols.applicable_accessibilities = public, internal, protected
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# 注：私有字段命名（_camelCase / s_xxx / Win32 SCREAMING_CASE 常量）历史风格多样，
# 不纳入构建门禁（渐进式）；构建仅强制接口 I 前缀与公开类型/成员 PascalCase。

# ---- 代码风格（suggestion 级：IDE 提示，不阻塞构建，渐进式收紧） ----

# 优先 using 引用而非全限定名（项目规范）
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# var 使用偏好
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:silent

# 表达式主体成员
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion

# using 排序：System 优先
dotnet_sort_system_directives_first = true

# 现代语言特性偏好
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
