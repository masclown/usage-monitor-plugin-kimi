<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>UsageMonitor.LoginHelper</RootNamespace>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UsageMonitor.LoginHelper</AssemblyName>
    <!-- req-107 B6：IUsageProvider 收敛过渡期，抑制过时接口成员警告 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageMonitor.Core\UsageMonitor.Core.csproj" />
  </ItemGroup>

  <!-- Stage F：MiniMax 纯声明包随构建复制到 plugins/ 目录，供声明包扫描加载（零 ProjectReference）。 -->
  <ItemGroup>
    <Content Include="..\Plugins\UsageMonitor.Plugin.MiniMax\defaults.json"
             Link="plugins\UsageMonitor.Plugin.MiniMax\defaults.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>