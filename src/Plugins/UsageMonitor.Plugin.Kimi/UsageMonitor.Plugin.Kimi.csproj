<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- req-086-3.4：旧插件继续使用旧字段，抑制 CS0618 警告 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <UseWPF>true</UseWPF>
    <RootNamespace>UsageMonitor.Plugin.Kimi</RootNamespace>
    <AssemblyName>UsageMonitor.Plugin.Kimi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UsageMonitor.Core\UsageMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.50.0" />
  </ItemGroup>

</Project>
