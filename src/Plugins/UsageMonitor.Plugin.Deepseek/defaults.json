{
  "schemaVersion": 1,
  "minSdkVersion": "0.24.3",
  "providerId": "Deepseek",
  "displayName": "Deepseek",
  "card": {
    "baseInfo": {
      "fields": [
        { "fieldName": "subscription_tier", "role": "Meta" },
        { "fieldName": "account_display_name", "role": "Meta" },
        { "fieldName": "quota_period_end_at", "role": "Reset" }
      ]
    },
    "charts": [
      {
        "chartId": "ds.chart.bar",
        "kind": "Bar",
        "defaultOrder": 1,
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "ds.bar.balance" },
        "tooltip": { "fields": ["remaining_amount"] },
        "colorTiers": { "ref": "global:usage-tier-default" },
        "dataGroups": [
          {
            "id": "ds.bar.balance",
            "fields": [
              { "fieldName": "balance_amount", "role": "Value" },
              { "fieldName": "monthly_upper_limit", "role": "Upper" }
            ]
          },
          {
            "id": "ds.bar.bonus",
            "fields": [
              { "fieldName": "bonus_balance_amount", "role": "Value" },
              { "fieldName": "weekly_upper_limit", "role": "Upper" }
            ]
          }
        ]
      },
      {
        "chartId": "ds.chart.number",
        "kind": "Number",
        "defaultOrder": 2,
        "dataGroups": [
          { "id": "ds.number.tokens", "fields": [{ "fieldName": "available_token_estimation", "role": "Value" }] },
          { "id": "ds.number.requests", "fields": [{ "fieldName": "request_count", "role": "Value" }] }
        ]
      }
    ]
  },
  "taskbar": {
    "baseInfo": {
      "fields": [
        { "fieldName": "subscription_tier", "role": "Meta" }
      ]
    },
    "miniCharts": [
      {
        "chartId": "ds.mini.ring",
        "kind": "MiniRingChart",
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "ds.taskbar.balance" },
        "dataGroups": [
          { "id": "ds.taskbar.balance", "fields": [{ "fieldName": "balance_amount", "role": "Value" }] }
        ]
      }
    ]
  }
}