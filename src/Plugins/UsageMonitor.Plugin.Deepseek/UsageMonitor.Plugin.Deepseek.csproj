<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>UsageMonitor.Plugin.Deepseek</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- req-086-3.4：旧插件继续使用旧字段，抑制 CS0618 警告 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UsageMonitor.Core\UsageMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- req-108 Task3：显示声明 defaults.json（随构建复制到输出目录） -->
    <None Include="defaults.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
