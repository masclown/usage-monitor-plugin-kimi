{
  "schemaVersion": 1,
  "minSdkVersion": "0.24.3",
  "providerId": "MiniMax",
  "displayName": "MiniMax",
  "usageUrls": {
    "zh-CN": "https://platform.minimaxi.com/console/usage",
    "en-US": "https://platform.minimax.io/console/usage",
    "ko-KR": "https://platform.minimax.io/ko/console/usage"
  },
  "fetch": {
    "endpoints": [
      {
        "urlMatch": "remains_percent",
        "finds": [
          {
            "itemsPath": "$.model_remains", "matchField": "model_name", "matchValue": "general",
            "fields": [
              { "path": "$.current_interval_used_percent", "target": "mm_5hUsedPercent", "transform": "parsePercent" },
              { "path": "$.current_weekly_used_percent", "target": "mm_weeklyUsedPercent", "transform": "parsePercent" },
              { "path": "$.end_time", "target": "mm_5hResetAt", "transform": "fromUnixMs" },
              { "path": "$.weekly_end_time", "target": "mm_weeklyResetAt", "transform": "fromUnixMs" }
            ]
          },
          {
            "itemsPath": "$.model_remains", "matchField": "model_name", "matchValue": "video",
            "fields": [
              { "path": "$.current_interval_total_count", "target": "mm_videoIntervalTotal", "transform": "parseNumber" },
              { "path": "$.current_interval_remains_count", "target": "mm_videoIntervalRemaining", "transform": "parseNumber" },
              { "path": "$.current_weekly_total_count", "target": "mm_videoWeeklyTotal", "transform": "parseNumber" },
              { "path": "$.current_weekly_remains_count", "target": "mm_videoWeeklyRemaining", "transform": "parseNumber" }
            ]
          }
        ]
      },
      {
        "urlMatch": "usage_summary",
        "fields": [
          { "path": "$.total_days", "target": "mm_totalDays", "transform": "parseNumber" },
          { "path": "$.active_days", "target": "mm_activeDays", "transform": "parseNumber" },
          { "path": "$.usage_ranking_percent", "target": "mm_rankingPercent", "transform": "parseNumber" },
          { "path": "$.total_token_consumed", "target": "mm_totalTokens", "transform": "identity" },
          { "path": "$.most_active_day.date", "target": "mm_mostActiveDate" },
          { "path": "$.most_active_day.token_count", "target": "mm_mostActiveToken", "transform": "parseFormattedToken" },
          { "path": "$.most_active_day.token_count", "target": "mm_mostActiveTokenText", "transform": "identity" }
        ],
        "arrays": [
          {
            "itemsPath": "$.date_model_usage",
            "mode": "parallel",
            "itemFields": [
              { "path": "$.date", "target": "mm_dailyTokenDates", "elementType": "string" },
              { "path": "$.total_token", "target": "mm_dailyTokenValues", "elementType": "long" },
              { "path": "$.cache_hit_percent", "target": "mm_dailyCacheHitPercents", "transform": "parsePercent", "elementType": "double" }
            ]
          },
          {
            "itemsPath": "$.date_model_usage",
            "mode": "objects",
            "nestedItems": "models",
            "target": "mm_modelDaily",
            "inheritFromParent": { "date": "date" },
            "itemFields": [
              { "path": "$.model", "target": "model" },
              { "path": "$.input_token", "target": "input_token", "transform": "parseNumber" },
              { "path": "$.output_token", "target": "output_token", "transform": "parseNumber" },
              { "path": "$.cache_read_token", "target": "cache_read_token", "transform": "parseNumber" },
              { "path": "$.total_token", "target": "total_token", "transform": "parseNumber" },
              { "path": "$.cache_hit_percent", "target": "cache_hit_percent", "transform": "parsePercent" }
            ]
          }
        ]
      },
      {
        "urlMatch": "token_plan_credit",
        "fields": [
          { "path": "$.remaining_credits", "target": "mm_remainingCredits", "transform": "parseNumber" },
          { "path": "$.total_credits", "target": "mm_totalCredits", "transform": "parseNumber" }
        ]
      }
    ],
    "aggregates": [
      { "urlMatch": "usage_summary", "itemsPath": "$.date_model_usage", "op": "weightedAvg", "valuePath": "$.cache_hit_percent", "valueTransform": "parsePercent", "weightPath": "$.total_token", "target": "mm_cacheHitPercent" }
    ],
    "computed": [
      { "target": "mm_videoIntervalUsed", "op": "subtract", "operands": ["mm_videoIntervalTotal", "mm_videoIntervalRemaining"] },
      { "target": "mm_videoWeeklyUsed", "op": "subtract", "operands": ["mm_videoWeeklyTotal", "mm_videoWeeklyRemaining"] }
    ],
    "dom": [
      { "tool": "jsFunction", "source": "() => { const els=Array.from(document.querySelectorAll('span,div,p')); const cands=els.map(x=>(x.textContent||'').trim()).filter(t=>t.length>0 && t.length<40 && (t.indexOf('·')>=0||t.indexOf('・')>=0) && (/Plan/.test(t)||t.indexOf('会员')>=0)); if(cands.length===0) return null; cands.sort((a,b)=>a.length-b.length); return cands[0]; }", "target": "mm_subscriptionRaw" }
    ],
    "accountId": { "urlMatch": "group/list", "path": "$.groups[0].group_id" }
  },
  "card": {
    "renderKinds": ["subscriptionTitle", "primaryBar", "weeklyBar", "videoProgress", "summary", "ranking", "credits"],
    "primaryMetric": "five_hour_used_percent",
    "baseInfo": {
      "fields": [
        { "fieldName": "subscription_type", "role": "Meta" },
        { "fieldName": "subscription_tier", "role": "Meta" },
        { "fieldName": "account_display_name", "role": "Meta" },
        { "fieldName": "five_hour_reset_at", "role": "Reset" }
      ]
    },
    "charts": [
      {
        "chartId": "mm.chart.usage_bar",
        "kind": "Bar",
        "defaultOrder": 1,
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "mm.bar.5h" },
        "tooltip": { "fields": ["five_hour_used_percent"] },
        "colorTiers": { "ref": "global:usage-tier-default" },
        "dataGroups": [
          {
            "id": "mm.bar.5h",
            "fields": [
              { "fieldName": "five_hour_used_percent", "role": "Value" },
              { "fieldName": "five_hour_upper_limit", "role": "Upper" },
              { "fieldName": "five_hour_lower_limit", "role": "Lower" }
            ]
          },
          {
            "id": "mm.bar.weekly",
            "fields": [
              { "fieldName": "weekly_used_percent", "role": "Value" },
              { "fieldName": "weekly_upper_limit", "role": "Upper" },
              { "fieldName": "weekly_lower_limit", "role": "Lower" }
            ]
          },
          {
            "id": "mm.bar.video",
            "fields": [
              { "fieldName": "video_quota", "role": "Value" },
              { "fieldName": "video_quota_limit", "role": "Upper" }
            ],
            "colorTiers": {
              "thresholds": [0, 1, 2, 3],
              "colors": ["#9E9E9E", "#2196F3", "#FFC107", "#F44336"]
            }
          }
        ]
      },
      {
        "chartId": "mm.chart.daily_line",
        "kind": "Line",
        "defaultOrder": 3,
        "slicer": {
          "mode": "Period",
          "position": "TopRight",
          "interaction": "Button",
          "timeRanges": ["Last7Days", "Last30Days"],
          "default": "Last30Days"
        },
        "tooltip": { "fields": ["daily_token_value"] },
        "dataGroups": [
          {
            "id": "mm.line.daily_tokens",
            "fields": [
              { "fieldName": "daily_token_date", "role": "Meta" },
              { "fieldName": "daily_token_value", "role": "Value" }
            ]
          }
        ]
      },
      {
        "chartId": "mm.chart.cache_heatmap",
        "kind": "HeatMap",
        "defaultOrder": 4,
        "tooltip": { "fields": ["daily_cache_hit_value"] },
        "colorTiers": {
          "thresholds": [0, 30, 60, 80, 100],
          "colors": ["#F5F5F5", "#FFE082", "#FFB74D", "#E64A19", "#B71C1C"]
        },
        "dataGroups": [
          {
            "id": "mm.heatmap.cache",
            "queryRange": { "type": "LastDays", "days": 90 },
            "fields": [
              { "fieldName": "daily_cache_hit_date", "role": "Meta" },
              { "fieldName": "daily_cache_hit_value", "role": "Value" }
            ]
          }
        ]
      },
      {
        "chartId": "mm.chart.remaining_number",
        "kind": "Number",
        "defaultOrder": 2,
        "dataGroups": [
          { "id": "mm.number.remaining", "fields": [{ "fieldName": "remaining_credits", "role": "Value" }] }
        ]
      },
      {
        "chartId": "mm.chart.tokenplan_bar",
        "kind": "Bar",
        "defaultOrder": 6,
        "planType": "TokenPlan",
        "tooltip": { "fields": ["five_hour_used_percent"] },
        "colorTiers": { "ref": "global:usage-tier-default" },
        "dataGroups": [
          {
            "id": "mm.bar.tokenplan.5h",
            "planType": "TokenPlan",
            "fields": [
              { "fieldName": "five_hour_used_percent", "role": "Value" },
              { "fieldName": "five_hour_upper_limit", "role": "Upper" }
            ]
          }
        ]
      }
    ]
  },
  "taskbar": {
    "baseInfo": {
      "fields": [
        { "fieldName": "subscription_tier", "role": "Meta" },
        { "fieldName": "five_hour_reset_at", "role": "Reset" }
      ]
    },
    "miniCharts": [
      {
        "chartId": "mm.mini.ring",
        "kind": "MiniRingChart",
        "slicer": { "mode": "DataGroup", "interaction": "Scroll", "default": "mm.taskbar.5h" },
        "tooltip": { "fields": ["five_hour_used_percent"] },
        "colorTiers": { "ref": "global:usage-tier-default" },
        "dataGroups": [
          { "id": "mm.taskbar.5h", "fields": [{ "fieldName": "five_hour_used_percent", "role": "Value" }] },
          { "id": "mm.taskbar.weekly", "fields": [{ "fieldName": "weekly_used_percent", "role": "Value" }] }
        ]
      },
      {
        "chartId": "mm.mini.text",
        "kind": "MiniText",
        "dataGroups": [
          { "id": "mm.taskbar.reset", "fields": [{ "fieldName": "five_hour_reset_at", "role": "Reset" }] }
        ]
      }
    ]
  }
}
