<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>UsageMonitor.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  <!-- req-107 B6：IUsageProvider 收敛过渡期，抑制过时接口成员警告 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!--
      Microsoft.Playwright: 替代裸 CDP，复刻销项数据助手 browser-cookie-manager Skill。
      Playwright 提供高级 API（page.goto / context.cookies / page.wait_for_url），
      复用系统已安装的 Microsoft Edge（channel=msedge），不下载 Chromium。
      解决反复出现的 5+ Bug：页面太小、navigate 丢失、URL 关键字误判、Cookie 提取失败等。
    -->
    <PackageReference Include="Microsoft.Playwright" Version="1.50.0" />
    <!--
      Microsoft.Data.Sqlite: 用量历史数据持久化。
      - 文件位于 %AppData%/UsageMonitor/history.db（与 config.json 同目录）
      - 通过 Microsoft.Data.Sqlite.Core 原生 API 操作，避免引入 EF Core 重量级依赖
      - 仅依赖 Microsoft.Data.Sqlite.Core 8.0.0，自动拉取 SQLitePCLRaw.bundle_e_sqlite3
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

</Project>