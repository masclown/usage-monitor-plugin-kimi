<Application x:Class="UsageMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UsageMonitor.App.Helpers"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 全局颜色资源 -->
        <Color x:Key="PrimaryColor">#FF2563EB</Color>
        <Color x:Key="SuccessColor">#FF16A34A</Color>
        <Color x:Key="WarningColor">#FFD97706</Color>
        <Color x:Key="DangerColor">#FFDC2626</Color>
        <Color x:Key="BgColor">#FF1E1E2E</Color>
        <Color x:Key="SurfaceColor">#FF2D2D3F</Color>
        <Color x:Key="TextPrimaryColor">#FFE2E8F0</Color>
        <Color x:Key="TextSecondaryColor">#FF94A3B8</Color>
        
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

        <!-- 值转换器 -->
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <helpers:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <helpers:ErrorColorConverter x:Key="ErrorColorConverter" />
        <helpers:PercentageWidthConverter x:Key="PercentageWidthConverter" />
        <helpers:PercentageToWidthConverter x:Key="PercentageToWidthConverter" />
    </Application.Resources>
</Application>
