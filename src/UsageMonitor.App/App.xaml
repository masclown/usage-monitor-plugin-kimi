<Application x:Class="UsageMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:UsageMonitor.App.Helpers"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 值转换器：不随主题变化，作为内联资源保留（必须先于 MergedDictionaries 声明）。
                 主题颜色/画笔已全部迁入 Themes/Dark.xaml、Themes/Light.xaml，
                 通过 ThemeManager 在运行时替换主题字典实现换肤。 -->
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:BoolToOpacityConverter x:Key="BoolToOpacity" />
            <helpers:ErrorColorConverter x:Key="ErrorColorConverter" />
            <helpers:PercentageWidthConverter x:Key="PercentageWidthConverter" />
            <helpers:PercentageToWidthConverter x:Key="PercentageToWidthConverter" />
            <helpers:StringToVisibilityConverter x:Key="StringToVisibility" />
            <helpers:RenderKindToVisibilityConverter x:Key="RenderKindToVisibility" />
            <helpers:SubscriptionTitleActiveConverter x:Key="SubscriptionTitleActive" />
            <helpers:PercentToBrushConverter x:Key="PercentToBrush" />
            <helpers:MultiVisibilityAndConverter x:Key="MultiVisibilityAnd" />
            <helpers:MultiVisibilityOrConverter x:Key="MultiVisibilityOr" />
            <helpers:RemainingPrefixConverter x:Key="RemainingPrefix" />
            <helpers:EnumToVisibilityConverter x:Key="EnumToVisibility" />
            <helpers:CardChartKindsContainsConverter x:Key="CardChartKindsContains" />
            <!-- REQ-003：环形图中心 metric 键转中文提示（在设置窗口 ListBox 中绑定显示） -->
            <helpers:RingMetricKeyToDisplayConverter x:Key="RingMetricKeyToDisplay" />

            <ResourceDictionary.MergedDictionaries>
                <!-- 顺序：Tokens（主题无关） → 主题（默认 Dark，运行时可被 ThemeManager 替换为 Light）
                     → Styles（隐式/命名样式，全部用 DynamicResource 引用主题画笔）
                     → 卡片主题 → 热力图占位默认样式。 -->
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
                <ResourceDictionary Source="Themes/CardThemes/UsageCardTheme.xaml" />
                <ResourceDictionary Source="Themes/ControlDefaults/HeatMapPlaceholder.Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
