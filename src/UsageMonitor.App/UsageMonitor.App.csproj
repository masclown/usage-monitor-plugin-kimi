<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>UsageMonitor.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 项目版本号（0.29.0-beta）：ConfigService大幅增强(+250行) / RefreshService大幅重构(+260行) / UsageHistoryRepository增强(+110行) / 新增CredentialProbe凭据探测 / 账户中心生命周期规范 / 认证提供者增强 / 大量测试新增；用于程序集元数据 + 文件属性。 -->
    <!-- 显式设置 5 个属性，避免被 SDK 衍生规则变动影响。 -->
    <Version>0.29.0-beta</Version>
    <AssemblyVersion>0.29.0.0</AssemblyVersion>
    <FileVersion>0.29.0.0</FileVersion>
    <InformationalVersion>0.29.0-beta</InformationalVersion>
    <ProductVersion>0.29.0-beta</ProductVersion>
    <AssemblyTitle>UsageMonitor</AssemblyTitle>
    <Product>UsageMonitor</Product>
    <Company>UsageMonitor</Company>
    <Copyright>Copyright © 2026</Copyright>
    <!-- req-055：DPI感知manifest，支持多显示器PerMonitorV2 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- req-086-3.4：App 层作为兼容层继续使用旧字段，抑制 CS0618 警告 -->
    <!-- req-055：app.manifest 有意声明 PerMonitorV2 DPI，抑制 WinForms 分析器 WFAC010 -->
    <NoWarn>$(NoWarn);CS0618;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageMonitor.Core\UsageMonitor.Core.csproj" />
  </ItemGroup>

  <!--
    Stage F（完全声明式插件架构）：宿主零内置 Provider。
    MiniMax 纯声明包（仅 defaults.json，零 DLL）随构建复制到输出目录
    plugins/UsageMonitor.Plugin.MiniMax/，由 PluginManager 声明包扫描加载。
  -->
  <ItemGroup>
    <Content Include="..\Plugins\UsageMonitor.Plugin.MiniMax\defaults.json"
             Link="plugins\UsageMonitor.Plugin.MiniMax\defaults.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!--
    图标资源（分发准备）：
    - 第三方服务商品牌 Logo 不再随包分发（规避商标再分发风险），改由 ProviderIconService
      在首次运行时按服务商域名抓取 favicon，缓存到 %AppData%/UsageMonitor/icons。
    - 仅保留本项目自有 Logo；用户如需离线自备第三方图标，可手动放入输出目录 Assets/Providers/{providerId}.png。
  -->
  <ItemGroup>
    <Content Include="Assets\Providers\usage-monitor-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
