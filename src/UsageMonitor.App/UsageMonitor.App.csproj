<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>UsageMonitor.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 项目版本号（0.26.0-beta）：Account实体模型/CardConfig卡片配置模型/Tooltip字段目录系统 / ConfigService大幅增强(+320行) / MainViewModel增强(+330行) / 设置窗口与插件配置窗口大幅增强 / RefreshService/DisplayModule/MiniChartRegistryBootstrapper增强 / AccountEntityTests/CardChartConfigTests测试；用于程序集元数据 + 文件属性。 -->
    <!-- 显式设置 5 个属性，避免被 SDK 衍生规则变动影响。 -->
    <Version>0.26.0-beta</Version>
    <AssemblyVersion>0.26.0.0</AssemblyVersion>
    <FileVersion>0.26.0.0</FileVersion>
    <InformationalVersion>0.26.0-beta</InformationalVersion>
    <ProductVersion>0.26.0-beta</ProductVersion>
    <AssemblyTitle>UsageMonitor</AssemblyTitle>
    <Product>UsageMonitor</Product>
    <Company>UsageMonitor</Company>
    <Copyright>Copyright © 2026</Copyright>
    <!-- req-055：DPI感知manifest，支持多显示器PerMonitorV2 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- req-086-3.4：App 层作为兼容层继续使用旧字段，抑制 CS0618 警告 -->
    <!-- req-055：app.manifest 有意声明 PerMonitorV2 DPI，抑制 WinForms 分析器 WFAC010 -->
    <NoWarn>$(NoWarn);CS0618;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageMonitor.Core\UsageMonitor.Core.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.Deepseek\UsageMonitor.Plugin.Deepseek.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.MiMo\UsageMonitor.Plugin.MiMo.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.MiniMax\UsageMonitor.Plugin.MiniMax.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.Kimi\UsageMonitor.Plugin.Kimi.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.Qoder\UsageMonitor.Plugin.Qoder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Provider 图标资源：复制到输出目录，运行时从文件加载 -->
  <ItemGroup>
    <Content Include="Assets\Providers\anthropic.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\deepseek.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\kimi.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\mimo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\minimax.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
