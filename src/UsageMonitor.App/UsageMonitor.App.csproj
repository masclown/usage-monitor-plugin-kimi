<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>UsageMonitor.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 项目版本号（0.14.0）：req-055 DPI感知manifest(PerMonitorV2) / BaseUrlValidator新增 / 多插件Provider增强 / PluginManager与TaskbarHelper改进；用于程序集元数据 + 文件属性。 -->
    <!-- 显式设置 5 个属性，避免被 SDK 衍生规则变动影响。 -->
    <Version>0.14.0</Version>
    <AssemblyVersion>0.14.0.0</AssemblyVersion>
    <FileVersion>0.14.0.0</FileVersion>
    <InformationalVersion>0.14.0</InformationalVersion>
    <ProductVersion>0.14.0</ProductVersion>
    <AssemblyTitle>UsageMonitor</AssemblyTitle>
    <Product>UsageMonitor</Product>
    <Company>UsageMonitor</Company>
    <Copyright>Copyright © 2026</Copyright>
    <!-- req-055：DPI感知manifest，支持多显示器PerMonitorV2 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageMonitor.Core\UsageMonitor.Core.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.Deepseek\UsageMonitor.Plugin.Deepseek.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.MiMo\UsageMonitor.Plugin.MiMo.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.OpenAI\UsageMonitor.Plugin.OpenAI.csproj" />
    <ProjectReference Include="..\Plugins\UsageMonitor.Plugin.MiniMax\UsageMonitor.Plugin.MiniMax.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Provider 图标资源：复制到输出目录，运行时从文件加载 -->
  <ItemGroup>
    <Content Include="Assets\Providers\anthropic.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\deepseek.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\kimi.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\mimo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\minimax.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\ollama.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\openai.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\openrouter.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\siliconflow.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\step.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\volcengine.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Providers\zhipu.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- req-016：项目 Logo 双主题版本（深色钟表/罗盘风格） -->
    <!-- req-032：单 logo 统一替换，不再按主题分 light/dark -->
    <Content Include="Assets\Providers\usage-monitor-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
