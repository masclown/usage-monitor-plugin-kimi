<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        简约浅色主题（珊瑚红）。键名与 Dark.xaml 完全一致。
        浅底上文字用近黑与冷灰，保证 >= 4.5:1 对比；tooltip 仍用深色气泡以对齐参考图。
    -->

    <!-- ===== 背景与表面 ===== -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF8F9FB" Offset="0" />
        <GradientStop Color="#FFEEF1F5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFF3F5F8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FFEEF0F3" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FFE8EBEF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FFE6E8EC" />

    <!-- ===== 文本 ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1B1F27" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5B6472" />
    <!-- req-071 U-01：对比度修正 #8A93A2 → #6B7280，3.5:1 → 5.3:1，达到 WCAG AA 标准 -->
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF6B7280" />

    <!-- ===== 强调色（珊瑚红）与语义 ===== -->
    <Color x:Key="AccentColor">#FFF5502E</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FF5502E" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF6B45" Offset="0" />
        <GradientStop Color="#FFF5482E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF16A34A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFDC2626" />

    <!-- ===== 图表 ===== -->
    <SolidColorBrush x:Key="ChartLineBrush" Color="{StaticResource AccentColor}" />
    <LinearGradientBrush x:Key="ChartAreaGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40F5502E" Offset="0" />
        <GradientStop Color="#00F5502E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#FFEDEFF3" />
    <SolidColorBrush x:Key="ChartAxisBrush" Color="#FFD3D8E0" />

    <!-- ===== Tooltip / 覆盖层 ===== -->
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#FF1F2430" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#FFE0E3E8" />

    <!-- ===== 卡片阴影（浅色底用柔和低透明度阴影） ===== -->
    <!-- req-071 U-03：BlurRadius 22→12，ShadowDepth 2→1，减少视觉噪点与性能损耗 -->
    <DropShadowEffect x:Key="CardShadowEffect" Color="#FF334155" BlurRadius="12"
                      ShadowDepth="1" Direction="270" Opacity="0.12" />

    <!-- ===== req-070 F-26：TriggerArea 覆盖层主题 Token ===== -->
    <SolidColorBrush x:Key="OverlayMaskBrush" Color="#60000000" />
    <SolidColorBrush x:Key="OverlayDebugBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OverlayDebugFillBrush" Color="#20F5502E" />
    <SolidColorBrush x:Key="OverlayHandleBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OverlayHandleBorderBrush" Color="{StaticResource AccentColor}" />

</ResourceDictionary>
