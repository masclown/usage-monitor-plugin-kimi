<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:UsageMonitor.App.Controls">

    <!-- 默认样式：把 HeatMapPlaceholder 当作占位渲染，按 Rows/Cols 拉灰格矩形。等 Stage-8 改写为真实数据。 -->
    <Style x:Key="{x:Type controls:HeatMapPlaceholder}" TargetType="{x:Type controls:HeatMapPlaceholder}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HeatMapPlaceholder}">
                    <Border Background="#FF2D2D3F"
                            CornerRadius="6"
                            Padding="10"
                            BorderBrush="#FF3D3D52"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="调用热力图（占位，168 天）"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0,0,0,6" />

                            <ItemsControl x:Name="HeatGrid"
                                          Grid.Row="1">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding Cols, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
