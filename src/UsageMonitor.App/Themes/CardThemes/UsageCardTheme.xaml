<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        订阅档位胶囊样式（已订阅 / 未订阅）。
        改用 {DynamicResource}：DynamicResource 在运行时对 Setter.Value 求值，
        既能随主题换肤，又天然规避 App.xaml 记载的 StaticResource=UnsetValue 历史坑。
    -->
    <Style x:Key="SubscriptionPillActiveStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- 订阅档位胶囊（未订阅 / 灰色描边） -->
    <Style x:Key="SubscriptionPillInactiveStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusButton}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
</ResourceDictionary>
