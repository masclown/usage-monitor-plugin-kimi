<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        高级深色主题。所有键名必须与 Light.xaml 完全一致，切换时仅替换字典实例。
        消费方一律用 {DynamicResource X} 引用，保证运行时换肤即时生效，
        并规避 App.xaml 记载的 Setter.Value StaticResource=UnsetValue 历史坑。
    -->

    <!-- ===== 背景与表面 ===== -->
    <!-- 窗口背景：竖向深蓝到近黑的渐变，增加层次与高级感 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF141824" Offset="0" />
        <GradientStop Color="#FF0E1016" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1B1F2A" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF232836" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF2A3040" />
    <SolidColorBrush x:Key="TrackBrush" Color="#FF2A3040" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF2C3242" />

    <!-- ===== 文本 ===== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA6B8" />
    <!-- req-071 U-02：对比度修正 #64748B → #94A3B8，3.3:1 → 6.2:1，达到 WCAG AA 标准 -->
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF94A3B8" />

    <!-- ===== 强调色（珊瑚橙）与语义 ===== -->
    <Color x:Key="AccentColor">#FFFF6B4A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33FF6B4A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF8A5C" Offset="0" />
        <GradientStop Color="#FFFF5C5C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF22C55E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFEF4444" />

    <!-- ===== 图表 ===== -->
    <SolidColorBrush x:Key="ChartLineBrush" Color="{StaticResource AccentColor}" />
    <!-- 折线下方渐变面积填充：珊瑚橙自上而下渐隐透明 -->
    <LinearGradientBrush x:Key="ChartAreaGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59FF6B4A" Offset="0" />
        <GradientStop Color="#00FF6B4A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#FF2C3242" />
    <SolidColorBrush x:Key="ChartAxisBrush" Color="#FF3A4152" />

    <!-- ===== Tooltip / 覆盖层（半透明用于任务栏/托盘） ===== -->
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#FF1F2430" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F21B1F2A" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#FF2C3242" />

    <!-- ===== 卡片阴影（深色底用较深阴影托起表面） ===== -->
    <!-- req-071 U-03：BlurRadius 18→10，ShadowDepth 3→2，Opacity 0.45→0.35 -->
    <DropShadowEffect x:Key="CardShadowEffect" Color="#FF000000" BlurRadius="10"
                      ShadowDepth="2" Direction="270" Opacity="0.35" />

    <!-- ===== req-070 F-26：TriggerArea 覆盖层主题 Token ===== -->
    <SolidColorBrush x:Key="OverlayMaskBrush" Color="#80000000" />
    <SolidColorBrush x:Key="OverlayDebugBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OverlayDebugFillBrush" Color="#20FF6B4A" />
    <SolidColorBrush x:Key="OverlayHandleBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OverlayHandleBorderBrush" Color="{StaticResource AccentColor}" />

</ResourceDictionary>
