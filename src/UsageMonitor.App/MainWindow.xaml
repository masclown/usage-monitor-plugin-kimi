<Window x:Class="UsageMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageMonitor - AI用量监控" 
        Height="600" Width="800"
        MinHeight="400" MinWidth="600"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="AI 用量监控" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" 
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" 
                        HorizontalAlignment="Right">
                <Button Content="刷新" Padding="16,8" 
                        Command="{Binding RefreshCommand}"
                        Background="{StaticResource PrimaryBrush}" 
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="13" Margin="8,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="设置" Padding="16,8" 
                        Click="OnSettingsClick"
                        Background="{StaticResource SurfaceBrush}" 
                        Foreground="{StaticResource TextPrimaryBrush}" 
                        BorderThickness="0" Cursor="Hand"
                        FontSize="13" Margin="8,0,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- 用量卡片列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Usages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" 
                                CornerRadius="10" Padding="20" Margin="0,0,0,12"
                                Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacity}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 服务商名称和状态 -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="13"
                                               Foreground="{Binding IsError, Converter={StaticResource ErrorColorConverter}}"
                                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- 进度条 -->
                                <Border Grid.Row="1" Height="8" CornerRadius="4" 
                                        Background="#FF3D3D52" Margin="0,0,0,12">
                                    <Border CornerRadius="4" HorizontalAlignment="Left"
                                            Background="{StaticResource PrimaryBrush}">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentageWidthConverter}">
                                                <Binding Path="UsagePercentage" />
                                                <Binding RelativeSource="{RelativeSource AncestorType=Border}" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>

                                <!-- 详细信息 -->
                                <UniformGrid Grid.Row="2" Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="已使用" FontSize="11" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding UsedText}" FontSize="14" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="总额度" FontSize="11" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="14" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="剩余额度" FontSize="11" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding RemainingText}" FontSize="14" 
                                                   Foreground="{StaticResource SuccessBrush}" 
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- 错误信息 -->
                                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                <Run Text="刷新间隔: " />
                <Run Text="{Binding RefreshInterval, StringFormat={}{0}秒}" />
                <Run Text=" | 插件数量: " />
                <Run Text="{Binding Usages.Count}" />
            </TextBlock>
        </Border>
    </Grid>
</Window>
