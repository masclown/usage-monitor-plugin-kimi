<Window x:Class="UsageMonitor.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:helpers="clr-namespace:UsageMonitor.App.Helpers"
        xmlns:vm="clr-namespace:UsageMonitor.App.ViewModels"
        Title="UsageMonitor - 设置"
        Height="640" Width="760"
        MinHeight="480" MinWidth="640"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- req-073：分区模板选择器 -->
        <helpers:SettingsSectionSelector x:Key="SectionSelector" />

        <!-- req-073：导航项选中态样式（VS Code 风格左侧导航）
             问题1：分组标题（IsGroupHeader=True）禁用命中测试与焦点，不可点击选中 -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{DynamicResource RadiusButton}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource MutedBrush}" />
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 问题1：分组标题行不可点击/不可选中/无手形光标，仅作普通文本展示 -->
                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Padding" Value="10,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- req-073：导航分组标题样式。问题1：字体/字号与导航按钮一致（FontSize=13），
             去掉额外左边距使其与按钮文本左对齐（左侧缩进统一由 ListBoxItem Padding 提供） -->
        <Style x:Key="NavGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- req-073：导航项模板选择器（分组标题 vs 可点击项）
             注意：以上两个 Style 必须在 NavGroupHeaderTemplate 之前定义，
             否则 DataTemplate 解析时找不到 Style 资源导致 SettingsWindow 加载崩溃。 -->
        <DataTemplate x:Key="NavGroupHeaderTemplate">
            <TextBlock Text="{Binding GroupName}" Style="{StaticResource NavGroupHeaderStyle}" />
        </DataTemplate>
        <DataTemplate x:Key="NavItemTemplate">
            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
        </DataTemplate>
        <helpers:SettingsNavigationTemplateSelector x:Key="NavTemplateSelector"
                                                     GroupHeaderTemplate="{StaticResource NavGroupHeaderTemplate}"
                                                     ItemTemplate="{StaticResource NavItemTemplate}" />

        <!-- ============================================================ -->
        <!-- req-073：各分区内容模板（从原 TabItem 迁移，绑定保持不变）    -->
        <!-- ============================================================ -->

        <!-- 常规设置 -->
        <DataTemplate x:Key="SettingsSection_General">
            <StackPanel Margin="4">
                <TextBlock Text="{helpers:Loc settings.general.title}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

                <!-- 外观主题 -->
                <TextBlock Text="{helpers:Loc settings.theme.label}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <Border Background="{DynamicResource MutedBrush}" CornerRadius="{DynamicResource RadiusButton}"
                        Padding="3" HorizontalAlignment="Left" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{helpers:Loc settings.theme.dark}" GroupName="Theme"
                                     Style="{StaticResource SegmentRadioStyle}"
                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                        <RadioButton Content="{helpers:Loc settings.theme.light}" GroupName="Theme"
                                     Style="{StaticResource SegmentRadioStyle}"
                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- S3：全局默认任务栏显示模式（原「任务栏显示」分区删除后迁移至常规分区） -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="任务栏显示模式（全局默认）" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding GlobalTaskbarModeOptions}"
                              ItemTemplate="{StaticResource KvpValueTemplate}" SelectedValuePath="Key"
                              TextSearch.TextPath="Value"
                              SelectedValue="{Binding GlobalTaskbarMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="180" HorizontalAlignment="Left" />
                    <TextBlock Text="所有未单独设置的 Provider 都使用此模式"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- 刷新间隔。req-077 U-20：加单位后缀 + 范围提示 -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{helpers:Loc settings.refresh.interval}" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <Grid HorizontalAlignment="Left" Width="180">
                        <TextBox Text="{Binding RefreshInterval, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,40,0" />
                        <TextBlock Text="{helpers:Loc settings.refresh.unit.seconds}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,12,0" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="{helpers:Loc settings.refresh.hint}"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <CheckBox Content="{helpers:Loc settings.autostart}" IsChecked="{Binding AutoStart}" Margin="0,0,0,12" />

                <!-- req-fix-关闭最小化设置：关闭主窗口行为开关（勾选=最小化到托盘，取消=完全退出） -->
                <CheckBox Content="关闭主窗口时最小化到托盘" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,4" />
                <TextBlock Text="取消勾选后，点击主窗口关闭按钮将直接退出程序"
                           FontSize="{DynamicResource FontSizeCaption}"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="22,0,0,12" />

                <Separator Margin="0,8,0,16" />

                <TextBlock Text="{helpers:Loc settings.history.title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{helpers:Loc settings.history.points}" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <ComboBox SelectedItem="{Binding HistoryPointCount}"
                              Width="120" HorizontalAlignment="Left">
                        <sys:Int32>30</sys:Int32>
                        <sys:Int32>60</sys:Int32>
                        <sys:Int32>120</sys:Int32>
                    </ComboBox>
                </StackPanel>

                <Separator Margin="0,8,0,16" />

                <TextBlock Text="{helpers:Loc settings.ring.thresholdTitle}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{helpers:Loc settings.ring.warning}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding RingChartWarningThreshold}" Width="100" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{helpers:Loc settings.ring.danger}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding RingChartDangerThreshold}" Width="100" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>

                <Separator Margin="0,4,0,16" />

                <!-- REQ-003 环形图增强设置：metric 启用/禁用 + 切换顺序 + sticky + 动画 -->
                <TextBlock Text="{helpers:Loc settings.ring.centerMetric}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <ItemsControl Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <sys:String>• 单击：开启或关闭该 metric</sys:String>
                    <sys:String>• 关闭后：中心数字变灰色</sys:String>
                    <sys:String>• 滚轮：循环切换显示顺序</sys:String>
                    <sys:String>• 鼠标离开 sticky 秒后：回默认 metric</sys:String>
                    <sys:String>• 修改后请点击底部"保存"生效</sys:String>
                </ItemsControl>
                <ItemsControl x:Name="RingMetricOrderList" ItemsSource="{Binding RingChartMetricOrder}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Converter={StaticResource RingMetricKeyToDisplay}}" FontSize="13"
                                           Margin="0,4,8,4" Cursor="Hand"
                                           MouseLeftButtonDown="OnRingMetricToggleClick" />
                                <StackPanel x:Name="MetricButtons" Grid.Column="1" Orientation="Horizontal" Visibility="Hidden">
                                    <Button Content="↑" Padding="6,2" Margin="0,0,4,0"
                                            Command="{Binding DataContext.MoveRingMetricUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource AccentSoftButtonStyle}" />
                                    <Button Content="↓" Padding="6,2"
                                            Command="{Binding DataContext.MoveRingMetricDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource AccentSoftButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MetricButtons" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="恢复默认顺序" Padding="12,4" Margin="0,0,0,12"
                        Command="{Binding ResetRingMetricOrderCommand}"
                        Style="{StaticResource GhostButtonStyle}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="sticky 秒数（鼠标离开后回默认，默认 5；0 = 永不回）" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding RingChartStickySeconds}" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="切换动画毫秒数（默认 180；0 = 禁用）" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding RingChartSwitchAnimationMs}" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 插件管理 -->
        <DataTemplate x:Key="SettingsSection_Plugins">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{helpers:Loc settings.plugins.title}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <!-- req-107 B9：设置界面“校验插件”按钮，选文件即校验，与命令行自检共用 PluginValidator -->
                    <Button Grid.Column="1" Content="校验插件…" Click="OnValidatePluginClick"
                            Style="{StaticResource GhostButtonStyle}" VerticalAlignment="Center"
                            ToolTip="选择插件 defaults.json，校验字段名 / 图表约束 / slicer / SDK 版本兼容" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding PluginItems}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="{DynamicResource RadiusCard}" Padding="14">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- 主行：启用 | 插件信息 | 账号徽标 | 配置 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center" Margin="0,0,14,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Run Text="{Binding DisplayName}" />
                                            <Run Text=" v" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Run Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                                            <Run Text="作者: " />
                                            <Run Text="{Binding Author}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- S1：账号数徽标（绿点 + 账号 × N + 箭头），点击展开/收起账号列表 -->
                                    <Button Grid.Column="2" Command="{Binding ToggleAccountsCommand}"
                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                            Style="{StaticResource GhostButtonStyle}" Padding="9,5"
                                            ToolTip="展开 / 收起账号列表">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 绿点：至少一个可用账号（启用且有凭据）=绿，否则=灰 -->
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUsableAccount}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="账号 × " />
                                                <Run Text="{Binding AccountCount, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ExpandArrowText}" VerticalAlignment="Center"
                                                       Margin="6,0,0,0" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="3" Content="配置"
                                            Command="{Binding ConfigCommand}"
                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                            Style="{StaticResource AccentSoftButtonStyle}" />
                                </Grid>

                                <!-- S1：账号列表面板（展开时显示） -->
                                <Border Background="{DynamicResource MutedBrush}"
                                        CornerRadius="{DynamicResource RadiusButton}" Padding="12"
                                        Margin="8,10,0,0"
                                        Visibility="{Binding IsAccountsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <!-- 账号行：启用 | 昵称 | API灯 | Sub灯 | 配置 | 删除 -->
                                        <ItemsControl ItemsSource="{Binding Accounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 启用 CheckBox（改动即 UpdateAccount 持久化） -->
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                                  ToolTip="启用 / 禁用该账号" />

                                                        <!-- 可编辑昵称（实时唯一校验，失焦保存） + 默认账号标记 + 错误提示 -->
                                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Grid.Column="0"
                                                                         Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}"
                                                                         VerticalAlignment="Center"
                                                                         LostFocus="OnAccountNicknameLostFocus"
                                                                         ToolTip="账号昵称（失焦保存，同 Provider 内唯一）" />
                                                                <TextBlock Grid.Column="1" Text="默认" VerticalAlignment="Center"
                                                                           Margin="6,0,0,0" FontSize="11"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                            <!-- 昵称校验错误（重名时红字提示并拒绝保存） -->
                                                            <TextBlock Text="{Binding NicknameError}"
                                                                       Visibility="{Binding NicknameError, Converter={StaticResource StringToVisibility}}"
                                                                       Foreground="{DynamicResource DangerBrush}" FontSize="11"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>

                                                        <!-- API 状态灯：Provider 已配置 API Key 时亮 -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                    ToolTip="API Key 状态（亮=已配置）">
                                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasApiKey}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="API" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        </StackPanel>

                                                        <!-- Sub 状态灯：AuthManager 中该账号有登录态时亮 -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                    ToolTip="登录态状态（亮=有效）">
                                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasLoginState}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="Sub" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        </StackPanel>

                                                        <!-- 配置按钮（打开 PluginConfigWindow，账号上下文传递由 S6 支持） -->
                                                        <Button Grid.Column="4" Content="配置"
                                                                Command="{Binding ConfigCommand}"
                                                                VerticalAlignment="Center" Margin="0,0,6,0"
                                                                Style="{StaticResource AccentSoftButtonStyle}" />

                                                        <!-- 删除按钮（确认弹框后 RemoveAccount） -->
                                                        <Button Grid.Column="5" Content="✕"
                                                                Command="{Binding DeleteCommand}"
                                                                VerticalAlignment="Center" Padding="7,4"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Foreground="{DynamicResource DangerBrush}"
                                                                ToolTip="删除该账号" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 无账号：显示「+ 创建账号」空状态按钮 -->
                                        <Button Content="+ 创建账号"
                                                Command="{Binding AddAccountCommand}"
                                                Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}}"
                                                Style="{StaticResource GhostButtonStyle}" Padding="14,6"
                                                HorizontalAlignment="Left" />

                                        <!-- 有账号：列表底部「+ 添加账号」按钮 -->
                                        <Button Content="+ 添加账号"
                                                Command="{Binding AddAccountCommand}"
                                                Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                Style="{StaticResource GhostButtonStyle}" Padding="14,6"
                                                HorizontalAlignment="Left" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </DataTemplate>

        <!-- S2：卡片管理（三级折叠：账号 → 图表 → 数据组 + tooltip 字段） -->
        <DataTemplate x:Key="SettingsSection_CardManage">
            <StackPanel Margin="4">
                <TextBlock Text="卡片管理" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                <!-- 账号列表 -->
                <ItemsControl ItemsSource="{Binding CardManage.AccountNodes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- 一级：账号行（logo + 账号名 + 展开箭头） -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Provider logo -->
                                        <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Source="{Binding IconPath}"
                                               Visibility="{Binding IconPath, Converter={StaticResource StringToVisibility}}" />

                                        <!-- 账号名 + 展开箭头 -->
                                        <Button Grid.Column="1" HorizontalContentAlignment="Left"
                                                Style="{StaticResource GhostButtonStyle}" Padding="4,6"
                                                Click="OnAccountNodeToggleClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ExpandArrow}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- 二级：图表列表（展开时显示） -->
                                    <Border Margin="8,10,0,0" Padding="10"
                                            Background="{DynamicResource MutedBrush}"
                                            CornerRadius="{DynamicResource RadiusButton}"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding ChartItems}">
                                                <ItemsControl.Resources>
                                                    <!-- 折叠分界线节点（问题2：与图表行完全同构——拖拽仅挂在手柄上、光标与图表行一致，
                                                         并用隐藏展开按钮占位保证行高与图表行一致） -->
                                                    <DataTemplate DataType="{x:Type vm:DividerNode}">
                                                        <Border Padding="6,8" Margin="0,0,0,6"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                CornerRadius="{DynamicResource RadiusButton}">
                                                            <!-- 与图表行同构的四列 Grid：拖拽手柄 + 隐藏复选框占位 + 文本 + 隐藏展开按钮占位 -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <!-- 拖拽手柄：与图表行同样式同交互（SizeAll 光标 + 手柄拖拽） -->
                                                                <TextBlock Grid.Column="0" Text="☰" FontSize="13" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0"
                                                                           Cursor="SizeAll"
                                                                           Tag="{Binding}"
                                                                           PreviewMouseLeftButtonDown="OnChartDragStart"
                                                                           PreviewMouseLeftButtonUp="OnChartDragEnd"
                                                                           MouseMove="OnChartDragMove" />
                                                                <!-- 隐藏复选框占位：宽度与图表行复选框一致，保证文字对齐 -->
                                                                <CheckBox Grid.Column="1" Margin="0,0,10,0" Visibility="Hidden"
                                                                          IsHitTestVisible="False" Focusable="False" />
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="折叠分界线" FontSize="13" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <TextBlock Text="（以下图表在卡片折叠时隐藏）" FontSize="11"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                </StackPanel>
                                                                <!-- 隐藏展开按钮占位：与图表行展开按钮同尺寸，保证分界线行高与图表行一致 -->
                                                                <Button Grid.Column="3" Content="▸" Visibility="Hidden"
                                                                        IsHitTestVisible="False" Focusable="False"
                                                                        Style="{StaticResource GhostButtonStyle}" Padding="7,3" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>

                                                    <!-- 图表实例节点 -->
                                                    <DataTemplate DataType="{x:Type vm:ChartNode}">
                                                        <Border Padding="6,8" Margin="0,0,0,6"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                CornerRadius="{DynamicResource RadiusButton}">
                                                            <StackPanel>
                                                                <!-- 图表行：拖拽手柄 + 启用 + 图表名 + 展开 + 删除 -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- 拖拽手柄 -->
                                                                    <TextBlock Grid.Column="0" Text="☰" FontSize="13"
                                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                               Cursor="SizeAll"
                                                                               Tag="{Binding}"
                                                                               PreviewMouseLeftButtonDown="OnChartDragStart"
                                                                               PreviewMouseLeftButtonUp="OnChartDragEnd"
                                                                               MouseMove="OnChartDragMove" />

                                                                    <!-- 启用 CheckBox -->
                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                                              VerticalAlignment="Center" Margin="0,0,10,0" />

                                                                    <!-- 图表名 + 类型 -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="{Binding KindText}" FontSize="11" Margin="8,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                    </StackPanel>

                                                                    <!-- 展开按钮 -->
                                                                    <Button Grid.Column="3" Content="{Binding ExpandArrow}"
                                                                            Style="{StaticResource GhostButtonStyle}" Padding="7,3"
                                                                            Click="OnChartNodeToggleClick" />

                                                                    <!-- 删除按钮（×）：移除该图表实例 -->
                                                                    <Button Grid.Column="4" Content="×" Padding="8,3" Margin="4,0,0,0"
                                                                            Style="{StaticResource GhostButtonStyle}"
                                                                            Foreground="{DynamicResource TextTertiaryBrush}"
                                                                            ToolTip="删除该图表"
                                                                            Command="{Binding RemoveSelfCommand}" />
                                                                </Grid>

                                                                <!-- 三级：数据组 + tooltip 字段（展开时显示） -->
                                                                <StackPanel Margin="24,8,0,0"
                                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                                    <!-- 数据组列表 -->
                                                                    <TextBlock Text="数据组" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                                    <ItemsControl ItemsSource="{Binding DataGroups}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,0,0,5">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- 拖拽手柄（问题5：挂 Up 事件 + 鼠标捕获，保证拖拽过程事件持续路由到手柄） -->
                                                                                    <TextBlock Grid.Column="0" Text="☰" FontSize="11"
                                                                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                               Cursor="SizeAll"
                                                                                               Tag="{Binding}"
                                                                                               PreviewMouseLeftButtonDown="OnDataGroupDragStart"
                                                                                               PreviewMouseLeftButtonUp="OnDataGroupDragEnd"
                                                                                               MouseMove="OnDataGroupDragMove" />

                                                                                    <!-- 启用 CheckBox -->
                                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                                                              VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                                    <!-- 数据组名 + 字段 chips -->
                                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                                                        <ItemsControl ItemsSource="{Binding FieldChips}">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <WrapPanel Orientation="Horizontal" />
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Border Background="{DynamicResource MutedBrush}"
                                                                                                            CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- S5：Tooltip 字段多选（问题9：带拖拽手柄，支持排序，顺序即 tooltip 行顺序） -->
                                                                    <TextBlock Text="Tooltip 字段" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,6" />
                                                                    <ItemsControl ItemsSource="{Binding TooltipFields}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                                                    <TextBlock Text="☰" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                               Cursor="SizeAll"
                                                                                               Tag="{Binding}"
                                                                                               PreviewMouseLeftButtonDown="OnTooltipFieldDragStart"
                                                                                               PreviewMouseLeftButtonUp="OnTooltipFieldDragEnd"
                                                                                               MouseMove="OnTooltipFieldDragMove" />
                                                                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                                              FontSize="12" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.Resources>
                                            </ItemsControl>

                                            <!-- 无图表：显示“配置图表”按钮 -->
                                            <Button Content="配置图表（恢复默认）"
                                                    Command="{Binding RestoreDefaultChartsCommand}"
                                                    Visibility="{Binding HasNoCharts, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource GhostButtonStyle}" Padding="14,6"
                                                    HorizontalAlignment="Left" Margin="0,4,0,0" />

                                            <!-- 添加图表按钮：置于白色折叠框内（图表列表之后）。问题5：与图表按钮同尺寸（Padding 14,6）、文字居中，保持浅红色 AccentSoft 样式 -->
                                            <Button Content="+ 添加图表" Padding="14,6" Margin="0,6,0,0"
                                                    HorizontalAlignment="Left"
                                                    HorizontalContentAlignment="Center"
                                                    Style="{StaticResource AccentSoftButtonStyle}"
                                                    ToolTip="添加图表"
                                                    Click="OnAddChartClick" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- 悬浮窗 -->
        <DataTemplate x:Key="SettingsSection_Tray">
            <StackPanel Margin="4">
                <TextBlock Text="悬浮窗设置" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                <CheckBox Content="鼠标悬停托盘图标时显示悬浮窗" IsChecked="{Binding ShowTrayTooltip}" Margin="0,0,0,12" />
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="悬浮窗停留时间" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" Minimum="100" Maximum="5000" TickFrequency="100"
                                IsSnapToTickEnabled="True"
                                Value="{Binding TrayTooltipHideDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="8,0"
                                 Text="{Binding TrayTooltipHideDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="毫秒"
                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <TextBlock Text="鼠标移出后，悬浮窗延迟关闭的时间（100-5000 毫秒）" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <Separator Margin="0,8,0,16" />

                <TextBlock Text="悬浮窗触发区域" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                    <Run Text="设置屏幕上光标在哪个矩形内才会弹出悬浮窗。与“悬浮窗位置”独立：你可以把窗体拖到触发区域外，但只有光标进入矩形才弹。" />
                </TextBlock>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="X（屏幕坐标）" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TriggerRectX, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Y（屏幕坐标）" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TriggerRectY, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Width（≥10）" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TriggerRectWidth, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Height（≥10）" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TriggerRectHeight, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="在屏幕上调整（进入蒙版）" Margin="0,0,8,0" Padding="14,6"
                            Command="{Binding EditTriggerAreaCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="恢复默认" Padding="14,6"
                            Command="{Binding ResetTriggerAreaCommand}"
                            Style="{StaticResource GhostButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <!-- 色阶（用量色阶 + 热力图色阶） -->
        <DataTemplate x:Key="SettingsSection_ColorTier">
            <StackPanel Margin="4" DataContext="{Binding TierEditor}">
                <TextBlock Text="用量色阶" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
                    <Run Text="所有按已用百分比换色的地方（主进度条 / 周限额 / 视频赠送 / 托盘悬浮窗 / 热力图）会按这表实时取色。" />
                    <LineBreak />
                    <Run Text="调整后点 “保存设置” 才会写入 config.json；“应用预览” 仅为实时查看效果不落盘。" />
                </TextBlock>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="启用" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Grid.Column="1" Text="阈值（%）" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Grid.Column="2" Text="颜色" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Grid.Column="3" Text="HEX" FontSize="12" Width="120" Margin="6,0,6,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding TierItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding MinPercent, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="22" CornerRadius="4" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1"
                                            Background="{Binding Color}" />
                                    <Button Content="选择颜色…" Padding="10,4"
                                            Command="{Binding PickColorCommand}"
                                            Style="{StaticResource AccentSoftButtonStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding ColorHex}" FontSize="12"
                                           VerticalAlignment="Center" Width="120" Margin="6,0,6,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Grid.Column="4" Content="删除" Padding="10,4"
                                        Command="{Binding RemoveCommand}"
                                        Style="{StaticResource GhostButtonStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                    <Button Content="添加档位" Margin="0,0,8,0" Padding="14,6"
                            Command="{Binding AddTierCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="应用预览" Margin="0,0,8,0" Padding="14,6"
                            Command="{Binding ApplyPreviewCommand}"
                            Style="{StaticResource AccentSoftButtonStyle}" />
                    <Button Content="恢复默认" Padding="14,6"
                            Command="{Binding ResetTierCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="24,0,0,0" />
                </StackPanel>

                <Separator Margin="0,4,0,16" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="保存设置" Padding="18,8"
                            Command="{Binding SaveTierCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock Text="（即时生效；下次启动按磁盘值恢复）" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <Separator Margin="0,20,0,20" />
                <TextBlock Text="热力图色阶" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
                    <Run Text="按 Token 绝对值分档（MiniMax 默认 6 档：0 / 20M / 100M / 200M / 300M），不同 Provider 独立色阶。" />
                    <LineBreak />
                    <Run Text="调整后点&quot;保存设置&quot;才会写入 config.json；&quot;应用预览&quot;仅为实时查看效果不落盘。" />
                </TextBlock>
                <StackPanel DataContext="{Binding HeatMapTierEditor}">
                    <TextBlock Text="Provider：" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding ProviderOptions}"
                              ItemTemplate="{StaticResource KvpValueTemplate}" SelectedValuePath="Key"
                              TextSearch.TextPath="Value"
                              SelectedValue="{Binding SelectedProviderId}"
                              Width="240" HorizontalAlignment="Left" Margin="0,0,0,16" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="启用" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="阈值（tokens）" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="2" Text="颜色" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="3" Text="HEX" FontSize="12" Width="120" Margin="6,0,6,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TierItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding MinTokens, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="22" CornerRadius="4" Margin="0,0,8,0"
                                                BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1"
                                                Background="{Binding Color}" />
                                        <Button Content="选择颜色…" Padding="10,4" Command="{Binding PickColorCommand}"
                                                Style="{StaticResource AccentSoftButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding ColorHex}" FontSize="12"
                                               VerticalAlignment="Center" Width="120" Margin="6,0,6,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Grid.Column="4" Content="删除" Padding="10,4" Command="{Binding RemoveCommand}"
                                            Style="{StaticResource GhostButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                        <Button Content="添加档位" Margin="0,0,8,0" Padding="14,6" Command="{Binding AddTierCommand}"
                                Style="{StaticResource AccentSoftButtonStyle}" />
                        <Button Content="恢复默认" Margin="0,0,8,0" Padding="14,6" Command="{Binding ResetToDefaultsCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="应用预览" Margin="0,0,8,0" Padding="14,6" Command="{Binding ApplyPreviewCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                    <Separator Margin="0,4,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存设置" Padding="18,8" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <TextBlock Text="（即时生效；下次启动按磁盘值恢复）" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 安全 -->
        <DataTemplate x:Key="SettingsSection_Security">
            <StackPanel Margin="4">
                <TextBlock Text="安全设置" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

                <TextBlock Text="文件访问控制（NTFS ACL）" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                <Border Background="{DynamicResource MutedBrush}" CornerRadius="{DynamicResource RadiusButton}"
                        Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Cookie 目录：" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Width="100" />
                            <TextBlock x:Name="CookieDirAclStatus" Text="检测中..." FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="配置目录：" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Width="100" />
                            <TextBlock x:Name="ConfigDirAclStatus" Text="检测中..." FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="收紧后仅当前 Windows 用户可访问 Cookie 和配置文件"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="立即应用 ACL 收紧" Padding="18,8" Click="ApplyAclTightening_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock Text="（首次启动时自动应用）" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <Separator Margin="0,8,0,16" />

                <TextBlock Text="Cookie 审计日志" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <TextBlock Text="（req-090 实现后可用）" FontSize="13"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,16" />

                <Separator Margin="0,8,0,16" />

                <TextBlock Text="Cookie 过期清理" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <TextBlock Text="（req-090 实现后可用）" FontSize="13"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <!-- 诊断 / 日志 -->
        <DataTemplate x:Key="SettingsSection_Diagnostics">
            <StackPanel Margin="4">
                <TextBlock Text="诊断与运行日志" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

                <TextBlock Text="运行日志路径" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="LogPathTextBox" IsReadOnly="True" Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="打开日志文件夹" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButtonStyle}" Click="OpenLogsFolder_Click" />
                    <Button Content="打开 debug 文件夹" Margin="0,0,8,0"
                            Style="{StaticResource GhostButtonStyle}" Click="OpenDebugFolder_Click" />
                    <Button Content="复制最新日志到剪贴板" Margin="0,0,8,0"
                            Style="{StaticResource GhostButtonStyle}" Click="CopyLatestLog_Click" />
                </StackPanel>

                <Separator Margin="0,8,0,16" />

                <TextBlock Text="日志说明" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20">
                    <Run Text="Logs saved to: &lt;projectRoot&gt;\logs\UsageMonitor-YYYY-MM-DD.log" />
                    <LineBreak /><LineBreak />
                    <Run Text="每个 MiniMax 用量查询的关键检查点都会写入日志，方便定位问题。" />
                    <LineBreak />
                    <Run Text="Debug dumps (XHR 响应 / DOM) saved to: &lt;projectRoot&gt;\logs\debug\" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- S4：任务栏迷你图表（三级折叠：账号 → mini 图表 → 数据组，与卡片管理页同构） -->
        <DataTemplate x:Key="SettingsSection_TaskbarMiniChart">
            <StackPanel Margin="4">
                <TextBlock Text="任务栏迷你图表" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                <!-- 账号列表 -->
                <ItemsControl ItemsSource="{Binding MiniChartManage.AccountNodes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- 一级：账号行（logo + 账号名 + 展开箭头） -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Provider logo -->
                                        <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0"
                                               VerticalAlignment="Center"
                                               Source="{Binding IconPath}"
                                               Visibility="{Binding IconPath, Converter={StaticResource StringToVisibility}}" />

                                        <!-- 账号名 + 展开箭头 -->
                                        <Button Grid.Column="1" HorizontalContentAlignment="Left"
                                                Style="{StaticResource GhostButtonStyle}" Padding="4,6"
                                                Click="OnMiniAccountNodeToggleClick">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ExpandArrow}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- 二级：mini 图表列表（展开时显示） -->
                                    <Border Margin="8,10,0,0" Padding="10"
                                            Background="{DynamicResource MutedBrush}"
                                            CornerRadius="{DynamicResource RadiusButton}"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding MiniCharts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="6,8" Margin="0,0,0,6"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                CornerRadius="{DynamicResource RadiusButton}">
                                                            <StackPanel>
                                                                <!-- 图表行：拖拽手柄 + 启用 + 图表名 + 展开 -->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- 拖拽手柄（问题5：挂 Up 事件 + 鼠标捕获） -->
                                                                    <TextBlock Grid.Column="0" Text="☰" FontSize="13"
                                                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                               Cursor="SizeAll"
                                                                               Tag="{Binding}"
                                                                               PreviewMouseLeftButtonDown="OnMiniChartDragStart"
                                                                               PreviewMouseLeftButtonUp="OnMiniChartDragEnd"
                                                                               MouseMove="OnMiniChartDragMove" />

                                                                    <!-- 启用 CheckBox -->
                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                                              VerticalAlignment="Center" Margin="0,0,10,0" />

                                                                    <!-- 图表名 + 类型 -->
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <TextBlock Text="{Binding KindText}" FontSize="11" Margin="8,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                    </StackPanel>

                                                                    <!-- 展开按钮 -->
                                                                    <Button Grid.Column="3" Content="{Binding ExpandArrow}"
                                                                            Style="{StaticResource GhostButtonStyle}" Padding="7,3"
                                                                            Click="OnMiniChartNodeToggleClick" />
                                                                </Grid>

                                                                <!-- 三级：数据组（展开时显示） -->
                                                                <StackPanel Margin="24,8,0,0"
                                                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                                    <!-- 数据组列表 -->
                                                                    <TextBlock Text="数据组" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                                    <ItemsControl ItemsSource="{Binding DataGroups}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,0,0,5">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <!-- 拖拽手柄（问题5：挂 Up 事件 + 鼠标捕获） -->
                                                                                    <TextBlock Grid.Column="0" Text="☰" FontSize="11"
                                                                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                               Cursor="SizeAll"
                                                                                               Tag="{Binding}"
                                                                                               PreviewMouseLeftButtonDown="OnMiniDataGroupDragStart"
                                                                                               PreviewMouseLeftButtonUp="OnMiniDataGroupDragEnd"
                                                                                               MouseMove="OnMiniDataGroupDragMove" />

                                                                                    <!-- 启用 CheckBox -->
                                                                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                                                              VerticalAlignment="Center" Margin="0,0,8,0" />

                                                                                    <!-- 数据组名 + 字段 chips -->
                                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                                                        <ItemsControl ItemsSource="{Binding FieldChips}">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <WrapPanel Orientation="Horizontal" />
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Border Background="{DynamicResource MutedBrush}"
                                                                                                            CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                                                                        <TextBlock Text="{Binding}" FontSize="10"
                                                                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- 问题8：Tooltip/文本显示字段多选（问题9：带拖拽手柄支持排序，勾选即保存） -->
                                                                    <TextBlock Text="Tooltip 字段" FontSize="12" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,6" />
                                                                    <ItemsControl ItemsSource="{Binding TooltipFields}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,4">
                                                                                    <TextBlock Text="☰" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                               Cursor="SizeAll"
                                                                                               Tag="{Binding}"
                                                                                               PreviewMouseLeftButtonDown="OnMiniTooltipFieldDragStart"
                                                                                               PreviewMouseLeftButtonUp="OnMiniTooltipFieldDragEnd"
                                                                                               MouseMove="OnMiniTooltipFieldDragMove" />
                                                                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsChecked}"
                                                                                              FontSize="12" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- req-073：左侧导航 + 右侧内容 + 底部全局保存栏 -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航（VS Code 风格分组） -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource RadiusCard}" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 通用 / 显示 / 高级 分组导航 -->
                        <ListBox x:Name="NavListBox"
                                 ItemsSource="{Binding SettingsNavigationItems}"
                                 SelectedValue="{Binding CurrentSection, Mode=TwoWay}"
                                 SelectedValuePath="Section"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 ItemTemplateSelector="{StaticResource NavTemplateSelector}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧内容：ScrollViewer + ContentControl（按 CurrentSection 切换 ContentTemplate） -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource RadiusCard}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                              helpers:ScrollViewerMouseWheelAssist.EnableBubbling="True">
                    <!-- req-099 修复（Bug1/2）：Content 绑定 VM 本体而非 CurrentSection 枚举，
                         确保各分区模板 DataContext 仍是 MainViewModel，否则模板内
                         {Binding PluginItems}/{Binding IsDarkTheme} 等会绑定到枚举值而失效。
                         模板切换改由 CurrentSection 的 DataTrigger 驱动。 -->
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_General}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.General}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_General}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Plugins}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Plugins}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.CardManage}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_CardManage}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Tray}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Tray}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.ColorTier}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_ColorTier}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Security}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Security}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Diagnostics}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Diagnostics}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.TaskbarMiniChart}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_TaskbarMiniChart}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部全局保存栏 -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,10"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{DynamicResource RadiusCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 未保存提示 -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="● " Foreground="{DynamicResource AccentBrush}" />
                    <Run Text="有未保存的修改" />
                </TextBlock>

                <!-- 取消 / 保存 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Padding="18,6" Margin="0,0,8,0"
                            Command="{Binding CancelSettingsCommand}"
                            Style="{StaticResource GhostButtonStyle}" />
                    <Button Content="保存" Padding="18,6"
                            Command="{Binding SaveAllSettingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
