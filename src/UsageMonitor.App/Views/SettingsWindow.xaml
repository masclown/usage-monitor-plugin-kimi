<Window x:Class="UsageMonitor.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageMonitor - 设置" 
        Height="500" Width="650"
        MinHeight="400" MinWidth="500"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <TabControl Margin="16" Background="Transparent" BorderThickness="0"
                Foreground="{StaticResource TextPrimaryBrush}">
        
        <!-- 常规设置 -->
        <TabItem Header="常规设置" Foreground="{StaticResource TextPrimaryBrush}">
            <StackPanel Margin="16">
                <TextBlock Text="常规设置" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

                <!-- 刷新间隔 -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="刷新间隔（秒）" FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding RefreshInterval}" Width="120" 
                             HorizontalAlignment="Left" Padding="8,6"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="#FF3D3D52" />
                </StackPanel>

                <!-- 任务栏显示 -->
                <CheckBox Content="启用任务栏显示" IsChecked="{Binding ShowInTaskbar}"
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"
                          FontSize="13" />

                <!-- 开机自启 -->
                <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStart}"
                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"
                          FontSize="13" />

                <Button Content="保存设置" Padding="20,10" HorizontalAlignment="Left"
                        Command="{Binding SaveSettingsCommand}"
                        Background="{StaticResource PrimaryBrush}" 
                        Foreground="White" BorderThickness="0" Cursor="Hand"
                        FontSize="13" Margin="0,16,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </TabItem>

        <!-- 插件管理 -->
        <TabItem Header="插件管理" Foreground="{StaticResource TextPrimaryBrush}">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="已安装插件" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                <ListView Grid.Row="1" ItemsSource="{Binding PluginItems}" 
                          Background="{StaticResource SurfaceBrush}" 
                          BorderThickness="0"
                          Foreground="{StaticResource TextPrimaryBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                              VerticalAlignment="Center" Margin="0,0,12,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding DisplayName}" />
                                            <Run Text=" v" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Run Text="{Binding Version}" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="作者: " />
                                            <Run Text="{Binding Author}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
