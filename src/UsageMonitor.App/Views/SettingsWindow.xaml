        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航（VS Code 风格分组） -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource RadiusCard}" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 通用 / 显示 / 高级 分组导航 -->
                        <ListBox x:Name="NavListBox"
                                 ItemsSource="{Binding SettingsNavigationItems}"
                                 SelectedValue="{Binding CurrentSection, Mode=TwoWay}"
                                 SelectedValuePath="Section"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 ItemTemplateSelector="{StaticResource NavTemplateSelector}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧内容：ScrollViewer + ContentControl（按 CurrentSection 切换 ContentTemplate） -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource RadiusCard}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <!-- req-099 修复（Bug1/2）：Content 绑定 VM 本体而非 CurrentSection 枚举，
                         确保各分区模板 DataContext 仍是 MainViewModel，否则模板内
                         {Binding PluginItems}/{Binding IsDarkTheme} 等会绑定到枚举值而失效。
                         模板切换改由 CurrentSection 的 DataTrigger 驱动。 -->
                    <ContentControl Content="{Binding}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_General}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.General}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_General}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Plugins}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Plugins}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Taskbar}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Taskbar}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Tray}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Tray}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.ColorTier}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_ColorTier}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Security}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Security}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.Diagnostics}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_Diagnostics}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.CardOrder}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_CardOrder}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.ChartOrder}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_ChartOrder}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.MultiProgress}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_MultiProgress}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static helpers:SettingsSection.TaskbarMiniChart}">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsSection_TaskbarMiniChart}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部全局保存栏 -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,10"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{DynamicResource RadiusCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 未保存提示 -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="● " Foreground="{DynamicResource AccentBrush}" />
                    <Run Text="有未保存的修改" />
                </TextBlock>

                <!-- 取消 / 保存 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消" Padding="18,6" Margin="0,0,8,0"
                            Command="{Binding CancelSettingsCommand}"
                            Style="{StaticResource GhostButtonStyle}" />
                    <Button Content="保存" Padding="18,6"
                            Command="{Binding SaveAllSettingsCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
