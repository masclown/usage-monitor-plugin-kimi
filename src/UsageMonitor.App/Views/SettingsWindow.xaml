                    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                        <Button Content="添加档位" Margin="0,0,8,0" Padding="14,6" Command="{Binding AddTierCommand}"
                                Style="{StaticResource AccentSoftButtonStyle}" />
                        <Button Content="恢复默认" Margin="0,0,8,0" Padding="14,6" Command="{Binding ResetToDefaultsCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="应用预览" Margin="0,0,8,0" Padding="14,6" Command="{Binding ApplyPreviewCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
