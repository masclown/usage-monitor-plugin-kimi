<Window x:Class="UsageMonitor.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="UsageMonitor - 设置"
        Height="640" Width="720"
        MinHeight="480" MinWidth="580"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterOwner">
    <TabControl Margin="16">

        <!-- 常规设置 -->
        <TabItem Header="常规设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Margin="16">
                    <TextBlock Text="常规设置" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

                    <!-- 外观主题 -->
                    <TextBlock Text="外观主题" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource MutedBrush}" CornerRadius="{DynamicResource RadiusButton}"
                            Padding="3" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="深色" GroupName="Theme"
                                         Style="{StaticResource SegmentRadioStyle}"
                                         IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                            <RadioButton Content="浅色" GroupName="Theme"
                                         Style="{StaticResource SegmentRadioStyle}"
                                         IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- 刷新间隔 -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="刷新间隔（秒）" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding RefreshInterval}" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>

                    <CheckBox Content="开机自动启动" IsChecked="{Binding AutoStart}" Margin="0,0,0,12" />

                    <Separator Margin="0,8,0,16" />

                    <!-- 桌面悬浮显示：taskbar window 与托盘悬浮窗 两个开关成对呈现 -->
                    <TextBlock Text="桌面悬浮显示" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <CheckBox Content="启用任务栏显示" IsChecked="{Binding ShowInTaskbar}" Margin="0,0,0,12" />
                    <CheckBox Content="鼠标悬停托盘图标时显示悬浮窗" IsChecked="{Binding ShowTrayTooltip}" Margin="0,0,0,12" />

                    <Separator Margin="0,8,0,16" />

                    <TextBlock Text="托盘悬浮窗" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="悬浮窗关闭延迟（毫秒）" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TrayTooltipHideDelayMs}" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>

                    <TextBlock Text="触发区域位于屏幕右下角托盘区，可使用下方“悬浮窗触发区域”区块以 X/Y/W/H 4 字段精细调整，或点“在屏幕上调整”蒙版拖拽。" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <!-- REQ-004 起：旧的 TrayTriggerWidth/TrayTriggerHeight TextBox 已升级为下方 X/Y/W/H 输入框与蒙版拖拽。
                         字段本身保留在 AppSettings 里以维持与旧版 config.json 的兼容性。 -->

                    <Separator Margin="0,8,0,16" />

                    <TextBlock Text="折线图历史数据" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="历史数据保留点数（30 / 60 / 120）" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox SelectedItem="{Binding HistoryPointCount}"
                                  Width="120" HorizontalAlignment="Left">
                            <sys:Int32>30</sys:Int32>
                            <sys:Int32>60</sys:Int32>
                            <sys:Int32>120</sys:Int32>
                        </ComboBox>
                    </StackPanel>

                    <Separator Margin="0,8,0,16" />

                    <TextBlock Text="圆环图阈值（达到百分比时切换颜色）" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="警告阈值（% 默认 60）" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RingChartWarningThreshold}" Width="100" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="危险阈值（% 默认 85）" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RingChartDangerThreshold}" Width="100" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,4,0,16" />

                    <!-- REQ-003 环形图增强设置：metric 切换顺序 + sticky + 动画 -->
                    <TextBlock Text="环形图中心数字（鼠标滚轮切换顺序）" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                        <Run Text="使用上下按钮调整顺序（拖拽排序留二期）。修改后点击保存设置。离开鼠标后 sticky 秒数后回默认。" />
                    </TextBlock>
                    <ListBox x:Name="RingMetricOrderList" Height="120" Margin="0,0,0,8"
                             ItemsSource="{Binding RingChartMetricOrder}"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource TrackBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RingMetricKeyToDisplay}}" FontSize="13" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="↑ 上移" Margin="0,0,8,0" Padding="12,4"
                                Command="{Binding MoveRingMetricUpCommand}"
                                CommandParameter="{Binding ElementName=RingMetricOrderList, Path=SelectedIndex}"
                                Style="{StaticResource AccentSoftButtonStyle}" />
                        <Button Content="↓ 下移" Margin="0,0,8,0" Padding="12,4"
                                Command="{Binding MoveRingMetricDownCommand}"
                                CommandParameter="{Binding ElementName=RingMetricOrderList, Path=SelectedIndex}"
                                Style="{StaticResource AccentSoftButtonStyle}" />
                        <Button Content="恢复默认顺序" Padding="12,4"
                                Command="{Binding ResetRingMetricOrderCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="sticky 秒数（鼠标离开后回默认，默认 5；0 = 永不回）" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RingChartStickySeconds}" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="切换动画毫秒数（默认 180；0 = 禁用）" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RingChartSwitchAnimationMs}" Width="120" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,4,0,16" />

                    <!-- REQ-004/006 触发区域设置（RectInt + VirtualScreen，最小 10×10） -->
                    <TextBlock Text="悬浮窗触发区域" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8">
                        <Run Text="设置屏幕上光标在哪个矩形内才会弹出悬浮窗。与“悬浮窗位置”独立：你可以把窗体拖到触发区域外，但只有光标进入矩形才弹。" />
                    </TextBlock>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="X（屏幕坐标）" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TriggerRectX, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Y（屏幕坐标）" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TriggerRectY, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Width（≥10）" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TriggerRectWidth, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Height（≥10）" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TriggerRectHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="在屏幕上调整（进入蒙版）" Margin="0,0,8,0" Padding="14,6"
                                Command="{Binding EditTriggerAreaCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="恢复默认" Padding="14,6"
                                Command="{Binding ResetTriggerAreaCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>

                    <Button Content="保存设置" HorizontalAlignment="Left"
                            Click="OnSaveClick"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 插件管理 -->
        <TabItem Header="插件管理">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="已安装插件" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                <ListView Grid.Row="1" ItemsSource="{Binding PluginItems}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                CornerRadius="{DynamicResource RadiusCard}" Padding="14">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                          VerticalAlignment="Center" Margin="0,0,14,0" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="{Binding DisplayName}" />
                                        <Run Text=" v" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Run Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}">
                                        <Run Text="作者: " />
                                        <Run Text="{Binding Author}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="任务栏显示" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableDisplayModes}"
                                              DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding DisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Width="110" />
                                </StackPanel>

                                <Button Grid.Column="3" Content="配置"
                                        Command="{Binding ConfigCommand}"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        Style="{StaticResource AccentSoftButtonStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </TabItem>

        <!-- req-022：任务栏显示（全局默认 + 每 Provider 覆盖的集中入口） -->
        <TabItem Header="任务栏显示">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Margin="16">
                    <TextBlock Text="任务栏显示模式" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
                        <Run Text="全局默认：所有未单独设置的 Provider 都使用此模式。" />
                        <LineBreak />
                        <Run Text="下方" />
                        <Run Text="每 Provider 覆盖" FontWeight="SemiBold" />
                        <Run Text="区域可单独设置某个 Provider，会覆盖全局默认。" />
                    </TextBlock>

                    <!-- 全局默认 -->
                    <TextBlock Text="全局默认" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding GlobalTaskbarModeOptions}"
                              DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding GlobalTaskbarMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="180" HorizontalAlignment="Left" Margin="0,0,0,20" />

                    <!-- 每 Provider 覆盖 -->
                    <Separator Margin="0,4,0,16" />
                    <TextBlock Text="每 Provider 覆盖" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <ListView ItemsSource="{Binding PluginItems}"
                              Background="Transparent" BorderThickness="0"
                              MaxHeight="240"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{DynamicResource SurfaceBrush}"
                                                    CornerRadius="{DynamicResource RadiusSmall}" Padding="10,6">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                               VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="140"
                                              ItemsSource="{Binding AvailableDisplayModes}"
                                              DisplayMemberPath="Value" SelectedValuePath="Key"
                                              SelectedValue="{Binding DisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 用量色阶 -->
        <TabItem Header="用量色阶">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Margin="16" DataContext="{Binding TierEditor}">
                    <TextBlock Text="用量色阶" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
                        <Run Text="所有按已用百分比换色的地方（主进度条 / 周限额 / 视频赠送 / 托盘悬浮窗 / 热力图）会按这表实时取色。" />
                        <LineBreak />
                        <Run Text="调整后点 “保存设置” 才会写入 config.json；“应用预览” 仅为实时查看效果不落盘。" />
                    </TextBlock>

                    <!-- 表头 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="启用" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="阈值（%）" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="2" Text="颜色" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="3" Text="HEX" FontSize="12" Width="120" Margin="6,0,6,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TierItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 启用 -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                    <!-- 阈值 -->
                                    <TextBox Grid.Column="1" Text="{Binding MinPercent, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                    <!-- 颜色预览 + 选择按钮 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="22" CornerRadius="4" Margin="0,0,8,0"
                                                BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1"
                                                Background="{Binding Color}" />
                                        <Button Content="选择颜色…" Padding="10,4"
                                                Command="{Binding PickColorCommand}"
                                                Style="{StaticResource AccentSoftButtonStyle}" />
                                    </StackPanel>
                                    <!-- HEX -->
                                    <TextBlock Grid.Column="3" Text="{Binding ColorHex}" FontSize="12"
                                               VerticalAlignment="Center" Width="120" Margin="6,0,6,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <!-- 删除 -->
                                    <Button Grid.Column="4" Content="删除" Padding="10,4"
                                            Command="{Binding RemoveCommand}"
                                            Style="{StaticResource GhostButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 操作行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                        <Button Content="添加档位" Margin="0,0,8,0" Padding="14,6"
                                Command="{Binding AddTierCommand}"
                                Style="{StaticResource AccentSoftButtonStyle}" />
                        <Button Content="恢复默认" Margin="0,0,8,0" Padding="14,6"
                                Command="{Binding ResetTierCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="应用预览" Margin="0,0,8,0" Padding="14,6"
                                Command="{Binding ApplyPreviewCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>

                    <Separator Margin="0,4,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存设置" Padding="18,8"
                                Command="{Binding SaveTierCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <TextBlock Text="（即时生效；下次启动按磁盘值恢复）" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 热力图色阶（req-011：镜像"用量色阶" Tab 结构，按 Provider 独立配置 token 绝对值分档） -->
        <TabItem Header="热力图色阶">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Margin="16" DataContext="{Binding HeatMapTierEditor}">
                    <TextBlock Text="热力图色阶" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16"
                               Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="18">
                        <Run Text="按 Token 绝对值分档（MiniMax 默认 6 档：0 / 20M / 100M / 200M / 300M），不同 Provider 独立色阶。" />
                        <LineBreak />
                        <Run Text="调整后点&quot;保存设置&quot;才会写入 config.json；&quot;应用预览&quot;仅为实时查看效果不落盘。" />
                    </TextBlock>

                    <TextBlock Text="Provider：" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding ProviderOptions}"
                              DisplayMemberPath="Value" SelectedValuePath="Key"
                              SelectedValue="{Binding SelectedProviderId}"
                              Width="240" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <!-- 表头 -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="启用" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="阈值（tokens）" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="2" Text="颜色" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="3" Text="HEX" FontSize="12" Width="120" Margin="6,0,6,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TierItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 启用 -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                    <!-- 阈值 tokens -->
                                    <TextBox Grid.Column="1" Text="{Binding MinTokens, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center" />
                                    <!-- 颜色预览 + 选择按钮 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="22" CornerRadius="4" Margin="0,0,8,0"
                                                BorderBrush="{DynamicResource TrackBrush}" BorderThickness="1"
                                                Background="{Binding Color}" />
                                        <Button Content="选择颜色…" Padding="10,4"
                                                Command="{Binding PickColorCommand}"
                                                Style="{StaticResource AccentSoftButtonStyle}" />
                                    </StackPanel>
                                    <!-- HEX -->
                                    <TextBlock Grid.Column="3" Text="{Binding ColorHex}" FontSize="12"
                                               VerticalAlignment="Center" Width="120" Margin="6,0,6,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <!-- 删除 -->
                                    <Button Grid.Column="4" Content="删除" Padding="10,4"
                                            Command="{Binding RemoveCommand}"
                                            Style="{StaticResource GhostButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                        <Button Content="添加档位" Margin="0,0,8,0" Padding="14,6"
                                Command="{Binding AddTierCommand}"
                                Style="{StaticResource AccentSoftButtonStyle}" />
                        <Button Content="恢复默认" Margin="0,0,8,0" Padding="14,6"
                                Command="{Binding ResetToDefaultsCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                        <Button Content="应用预览" Margin="0,0,8,0" Padding="14,6"
                                Command="{Binding ApplyPreviewCommand}"
                                Style="{StaticResource GhostButtonStyle}" />
                    </StackPanel>

                    <Separator Margin="0,4,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存设置" Padding="18,8"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <TextBlock Text="（即时生效；下次启动按磁盘值恢复）" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- req-026 环形图中心：按 Provider 独立配置要显示的数字 -->
        <TabItem Header="环形图中心">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="环形图中心数字（按 Provider 独立设置）" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
                        <Run Text="以下勾选只控制“关闭后中心数字显浅灰”。插件提供哪些数字类型在此处分项展示。" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ProviderRingChartMetricGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="{DynamicResource RadiusCard}" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProviderDisplayName}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Metrics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayName}"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Margin="0,0,16,0"
                                                              Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- 诊断 / 日志 -->
        <TabItem Header="诊断 / 日志">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel Margin="16">
                    <TextBlock Text="诊断与运行日志" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

                    <TextBlock Text="运行日志路径" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="LogPathTextBox" IsReadOnly="True" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="打开日志文件夹" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}" Click="OpenLogsFolder_Click" />
                        <Button Content="打开 debug 文件夹" Margin="0,0,8,0"
                                Style="{StaticResource GhostButtonStyle}" Click="OpenDebugFolder_Click" />
                        <Button Content="复制最新日志到剪贴板" Margin="0,0,8,0"
                                Style="{StaticResource GhostButtonStyle}" Click="CopyLatestLog_Click" />
                    </StackPanel>

                    <Separator Margin="0,8,0,16" />

                    <TextBlock Text="日志说明" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20">
                        <Run Text="Logs saved to: &lt;projectRoot&gt;\logs\UsageMonitor-YYYY-MM-DD.log" />
                        <LineBreak /><LineBreak />
                        <Run Text="每个 MiniMax 用量查询的关键检查点都会写入日志，方便定位问题。" />
                        <LineBreak />
                        <Run Text="Debug dumps (XHR 响应 / DOM) saved to: &lt;projectRoot&gt;\logs\debug\" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
