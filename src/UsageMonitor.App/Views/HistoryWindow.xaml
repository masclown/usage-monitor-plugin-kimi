<Window x:Class="UsageMonitor.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UsageMonitor.App.Controls"
        xmlns:helpers="clr-namespace:UsageMonitor.App.Helpers"
        Title="UsageMonitor - 历史用量"
        Height="720" Width="1120"
        MinHeight="560" MinWidth="880"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="历史用量" FontSize="{DynamicResource FontSizeHeading}" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="按 Provider、时间范围与图表类型回看用量趋势" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 工具/筛选条 -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{DynamicResource RadiusCard}" Padding="16,14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="已启用 Provider" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          FontSize="12" Margin="0,0,14,0"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="范围" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding RangeOptions}"
                              DisplayMemberPath="Value" SelectedValuePath="Key"
                              TextSearch.TextPath="Value"
                              SelectedValue="{Binding SelectedRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="130" />

                    <TextBlock Text="图表" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="18,0,8,0" />
                    <ComboBox ItemsSource="{Binding ChartKindOptions}"
                              DisplayMemberPath="Value" SelectedValuePath="Key"
                              TextSearch.TextPath="Value"
                              SelectedValue="{Binding SelectedChartKind, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Width="120" />

                    <Button Content="刷新" Margin="18,0,0,0" Click="OnRefreshClick"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="导出 CSV" Margin="10,0,0,0" Click="OnExportCsvClick"
                            Style="{StaticResource GhostButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主图区。req-078 U-27：右侧摘要卡改比例宽度 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" MinWidth="200" MaxWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="{DynamicResource RadiusCard}" Padding="16">
                <Grid>
                    <!-- req-078 U-28：图表切换加 200ms 淡入动画 -->
                    <controls:HistoryLineChartControl x:Name="LineChart"
                                                      Series="{Binding LineSeries}"
                                                      Dates="{Binding LineDates}"
                                                      AxisBrush="{DynamicResource ChartAxisBrush}"
                                                      GridLineBrush="{DynamicResource ChartGridBrush}"
                                                      TextBrush="{DynamicResource TextSecondaryBrush}"
                                                      AreaBrush="{DynamicResource ChartAreaGradientBrush}"
                                                      Visibility="{Binding IsLineChart, Converter={StaticResource BoolToVisibility}}">
                        <controls:HistoryLineChartControl.Style>
                            <Style TargetType="controls:HistoryLineChartControl">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </controls:HistoryLineChartControl.Style>
                    </controls:HistoryLineChartControl>

                    <controls:BarChartControl x:Name="BarChart"
                                              Values="{Binding BarValues}"
                                              BarBrush="{DynamicResource AccentGradientBrush}"
                                              GridLineBrush="{DynamicResource ChartAxisBrush}"
                                              TextBrush="{DynamicResource TextSecondaryBrush}"
                                              Visibility="{Binding IsBarChart, Converter={StaticResource BoolToVisibility}}" />

                    <controls:YearHeatMapControl x:Name="HeatMap"
                                                 Cells="{Binding HeatMapCells}"
                                                 EmptyCellBrush="{DynamicResource TrackBrush}"
                                                 TextBrush="{DynamicResource TextSecondaryBrush}"
                                                 Visibility="{Binding IsHeatMap, Converter={StaticResource BoolToVisibility}}" />

                    <controls:DayNightArcControl x:Name="ArcChart"
                                                 HourlyActivity="{x:Static helpers:SampleChartData.HourlyActivity}"
                                                 TrackBrush="{DynamicResource TextTertiaryBrush}"
                                                 AccentBrush="{DynamicResource AccentBrush}"
                                                 TextBrush="{DynamicResource TextSecondaryBrush}"
                                                 Visibility="{Binding IsDayNightArc, Converter={StaticResource BoolToVisibility}}" />

                    <!-- req-078 U-29：空状态升级为插画 + 操作按钮 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding NoDataWarning, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="暂无历史数据" FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="请先刷新数据或调整时间范围" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <Button Content="去刷新数据" Click="OnRefreshClick"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center" Padding="20,8" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧摘要。req-078 U-27：比例宽度 -->
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <Border Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="{DynamicResource RadiusCard}" Padding="16"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding IsSingleProviderSelected, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="当前 Provider 摘要" FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <controls:RingChartControl x:Name="RingChart"
                                                   Percent="{Binding RingLatestPercent, FallbackValue=0, TargetNullValue=0}"
                                                   Size="100" StrokeThickness="9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TrackBrush="{DynamicResource TrackBrush}"
                                                   ProgressBrush="{DynamicResource AccentBrush}"
                                                   WarningBrush="{DynamicResource WarningBrush}"
                                                   DangerBrush="{DynamicResource DangerBrush}"
                                                   Visibility="{Binding HasRingSeries, Converter={StaticResource BoolToVisibility}}" />
                        <!-- req-038：去掉 Provider 名字，仅显示采样点数 -->
                        <TextBlock Text="{Binding RingSampleCount, StringFormat=共 {0} 个采样点}"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 热力图统计卡（活跃天数 / 峰值 / 平均），对齐参考图 -->
                <StackPanel Visibility="{Binding IsHeatMap, Converter={StaticResource BoolToVisibility}}">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusCard}"
                            Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding ActiveDaysText}" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="活跃天数" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusCard}"
                            Padding="16,14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding PeakUsageText}" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="单日峰值用量" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusCard}"
                            Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{Binding AvgUsageText}" FontSize="{DynamicResource FontSizeDisplay}" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="平均用量" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 状态条 -->
        <TextBlock Grid.Row="3" Margin="0,12,0,8"
                   Text="{Binding StatusMessage}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />

        <!-- 详情 DataGrid（req-013：上方切片器 + 8 列 + 列头点击排序） -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="{DynamicResource RadiusCard}" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- req-013：切片器区块（DataGrid 上方） -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="{DynamicResource RadiusSmall}" Padding="10,6"
                        Margin="6,4,6,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="切片" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ItemsControl ItemsSource="{Binding Providers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              FontSize="11" Margin="0,0,8,0"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- req-078 U-26：DataGrid 列宽改比例 + 数值列右对齐 -->
                <DataGrid x:Name="DetailGrid" Grid.Row="1" ItemsSource="{Binding DetailRows}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" CanUserSortColumns="True"
                          Sorting="OnDataGridSorting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*" MinWidth="100" SortMemberPath="ProviderName" />
                        <DataGridTextColumn Header="日期" Binding="{Binding Day}" Width="Auto" MinWidth="80" SortMemberPath="Day" />
                        <DataGridTextColumn Header="刷新时间" Binding="{Binding RefreshedAtText}" Width="Auto" MinWidth="80" SortMemberPath="RefreshedAtText" />
                        <DataGridTextColumn Header="最高%" Binding="{Binding MaxPercent, StringFormat={}{0:0.0}}" Width="60" SortMemberPath="MaxPercent">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="最低%" Binding="{Binding MinPercent, StringFormat={}{0:0.0}}" Width="60" SortMemberPath="MinPercent">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="结束%" Binding="{Binding EndPercent, StringFormat={}{0:0.0}}" Width="60" SortMemberPath="EndPercent">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="平均%" Binding="{Binding AvgPercent, StringFormat={}{0:0.0}}" Width="60" SortMemberPath="AvgPercent">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="采样数" Binding="{Binding Snapshots}" Width="60" SortMemberPath="Snapshots">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
