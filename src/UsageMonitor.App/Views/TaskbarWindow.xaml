<Window x:Class="UsageMonitor.App.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UsageMonitor.App.Controls"
        xmlns:views="clr-namespace:UsageMonitor.App.Views"
        Title="UsageMonitor Taskbar"
        Icon="{Binding CurrentLogoSource}"
        Height="48" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        Cursor="SizeAll">
    <!--
        req-088 B5：TaskbarWindow 重构为绑定 ITaskbarMiniChartRegistry.GetAll()。
        拖拽入口走 override OnPreviewMouseXxx 虚方法（与 Stage-14.3 一致）。
        ⚠️ XAML 资源顺序约定：DataTemplate 必须先于 DataTemplateSelector 声明。
        WPF 资源按声明顺序解析，Selector 中 {StaticResource X} 是前向引用会抛 XamlParseException。
        教训见 devdoc/20260721223000_项目开发说明文档-XAML资源顺序踩坑.md
    -->
    <Window.Resources>
        <!-- req-088 B5：文字模式模板 -->
        <DataTemplate x:Key="MiniChartTextTemplate" DataType="{x:Type views:MiniChartItemViewModel}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        ToolTip="{Binding TooltipTitle, Mode=OneWay}"
                        ToolTipService.InitialShowDelay="{Binding TooltipShowDelayMs}">
                <TextBlock Text="{Binding ProviderId, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Text="{Binding UsagePercent, Mode=OneWay, StringFormat={}{0:F0}%, TargetNullValue=--, FallbackValue=--}" />
            </StackPanel>
        </DataTemplate>

        <!-- req-088 B5：圆环图模式模板 -->
        <!--
            Phase0 评审修复：WarningThreshold/DangerThreshold 设为 101（超出 percent 上限 100），
            使 SelectBrush 永远命中 ProgressBrush（即 TierBrush 绑定）——用户色阶不被构造函数
            自动填充的主题 WarningBrush/DangerBrush 覆盖（构造函数 L376-385 在 DP 为 null 时
            SetValue 主题资源，模板未绑定这两项则本地值保留）。
            req-107 B4：Grid 挂 PreviewMouseWheel 滚轮切数据组；ToolTip 改绑 CompositeTooltipText（标题+正文）。
        -->
        <DataTemplate x:Key="MiniChartRingChartTemplate" DataType="{x:Type views:MiniChartItemViewModel}">
            <Grid Width="38" Height="38" Margin="0,0,6,0" Background="Transparent"
                  PreviewMouseWheel="OnRingChartPreviewMouseWheel">
                <controls:RingChartControl Width="38" Height="38"
                                            Percent="{Binding UsagePercent, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"
                                            Size="38" StrokeThickness="3.5"
                                            TrackBrush="{DynamicResource TrackBrush}"
                                            ProgressBrush="{Binding TierBrush, Mode=OneWay}"
                                            WarningThreshold="101" DangerThreshold="101"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            IsHalfRing="True"
                                            ShowHoverTooltip="False"
                                            Tag="{Binding ProviderId, Mode=OneWay}"
                                            ToolTip="{Binding CompositeTooltipText, Mode=OneWay}"
                                            ToolTipService.Placement="Top"
                                            ToolTipService.VerticalOffset="-8"
                                            ToolTipService.InitialShowDelay="{Binding TooltipShowDelayMs}" />
            </Grid>
        </DataTemplate>

        <!-- req-088 B5：折线图模式模板 -->
        <DataTemplate x:Key="MiniChartLineChartTemplate" DataType="{x:Type views:MiniChartItemViewModel}">
            <controls:MiniLineChartControl Width="120" Height="22"
                                            Values="{Binding UsageVm.HistoryValues, Mode=OneWay}"
                                            StrokeThickness="1.6"
                                            LowBrush="{DynamicResource UsageLowBrush}"
                                            MidBrush="{DynamicResource UsageMidBrush}"
                                            HighBrush="{DynamicResource UsageHighBrush}"
                                            ToolTip="{Binding TooltipTitle, Mode=OneWay}"
                                            ToolTipService.InitialShowDelay="{Binding TooltipShowDelayMs}" />
        </DataTemplate>

        <!-- req-088 B5：柱状图模式模板（占位） -->
        <DataTemplate x:Key="MiniChartBarChartTemplate" DataType="{x:Type views:MiniChartItemViewModel}">
            <Border Width="80" Height="22" Margin="0,0,8,0"
                    Background="{DynamicResource TrackBrush}" CornerRadius="3"
                    ToolTip="MiniBarChart 占位（待 BarChartControl 接入）">
                <TextBlock Text="▌▌▌" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <!-- req-088 B5：热力图模式模板（占位） -->
        <DataTemplate x:Key="MiniChartHeatMapTemplate" DataType="{x:Type views:MiniChartItemViewModel}">
            <Border Width="120" Height="22" Margin="0,0,8,0"
                    Background="{DynamicResource TrackBrush}" CornerRadius="3"
                    ToolTip="MiniHeatMap 占位（待 YearHeatMapControl 接入）">
                <TextBlock Text="▦▦▦" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>

        <!--
            ⚠️ req-088 B5：DataTemplateSelector 必须声明在所有 DataTemplate 之后！
            上面 5 个 DataTemplate 注册到 Window.Resources 后，Selector 才能用 {StaticResource X} 找到它们。
        -->
        <views:MiniChartTemplateSelector x:Key="MiniChartTemplateSelector"
                                         TextTemplate="{StaticResource MiniChartTextTemplate}"
                                         RingChartTemplate="{StaticResource MiniChartRingChartTemplate}"
                                         LineChartTemplate="{StaticResource MiniChartLineChartTemplate}"
                                         BarChartTemplate="{StaticResource MiniChartBarChartTemplate}"
                                         HeatMapTemplate="{StaticResource MiniChartHeatMapTemplate}" />
    </Window.Resources>

    <Border Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="8" Padding="12,6" Margin="2"
            BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1"
            x:Name="RootBorder">
        <Grid>
            <!--
                req-088 B5/B6：ItemsControl 绑定 VisibleMiniCharts（来自 ITaskbarMiniChartRegistry），
                通过 MiniChartTemplateSelector 按 Kind 选模板。
                req-088 B8：当 CycleConfig.Enabled=true 时，由 TaskbarCycleService 控制可见子集；
                当前默认全可见（不滚动）。
            -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="0">
                <ItemsControl ItemsSource="{Binding VisibleMiniCharts, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource MiniChartTemplateSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
