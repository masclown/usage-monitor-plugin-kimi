<Window x:Class="UsageMonitor.App.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UsageMonitor.App.Controls"
        xmlns:views="clr-namespace:UsageMonitor.App.Views"
        Title="UsageMonitor Taskbar"
        Icon="{Binding CurrentLogoSource}"
        Height="44" Width="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        Cursor="SizeAll">
    <!--
        拖拽入口走 override OnPreviewMouseXxx 虚方法（与 Stage-14.3 一致），
        不在 XAML 绑 routed event，因为 override 是 100% 触发的入口，比 XAML 订阅更可靠。
    -->
    <Window.Resources>
        <!-- 文字模式模板：Logo + DisplayName + 剩余额度 -->
        <DataTemplate x:Key="TaskbarTextTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,16,0"
                        ToolTip="{Binding StatusText, Mode=OneWay}">
                <Image Source="{Binding IconPath, Mode=OneWay}" Width="14" Height="14"
                       VerticalAlignment="Center" Margin="0,0,4,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding IconPath, Converter={StaticResource StringToVisibility}}" />
                <TextBlock FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding DisplayName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="12" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="4,0,0,0">
                    <!-- 任务栏文字模式显示"剩余"百分比，加前缀避免与已用%混淆 -->
                    <Run Text="{Binding RemainingText, Mode=OneWay, Converter={StaticResource RemainingPrefix}}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- 折线图模式模板：上方文字 + 下方迷你折线图 -->
        <DataTemplate x:Key="TaskbarLineChartTemplate">
            <Grid Width="120" Height="44" Margin="0,0,12,0" VerticalAlignment="Center"
                  ToolTip="{Binding StatusText, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" VerticalAlignment="Center">
                    <Image Source="{Binding IconPath, Mode=OneWay}" Width="12" Height="12"
                           VerticalAlignment="Center" Margin="0,0,4,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IconPath, Converter={StaticResource StringToVisibility}}"
                           DockPanel.Dock="Left" />
                    <TextBlock FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Run Text="{Binding DisplayName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                               Text="{Binding UsagePercentage, Mode=OneWay, StringFormat={}{0:F0}%}" />
                </DockPanel>
                <controls:MiniLineChartControl Grid.Row="1"
                                                Values="{Binding HistoryValues, Mode=OneWay}"
                                                StrokeThickness="1.6"
                                                LowBrush="{DynamicResource UsageLowBrush}"
                                                MidBrush="{DynamicResource UsageMidBrush}"
                                                HighBrush="{DynamicResource UsageHighBrush}" />
            </Grid>
        </DataTemplate>

        <!-- 圆环图模式模板：req-051 重构 - 半圆环样式 -->
        <DataTemplate x:Key="TaskbarRingChartTemplate">
            <Grid Width="38" Height="38" Margin="0,0,8,0"
                  Background="Transparent"
                  ToolTip="{Binding TaskbarToolTipText, Mode=OneWay}"
                  ToolTipService.Placement="Top"
                  ToolTipService.VerticalOffset="-8"
                  ToolTipService.HorizontalOffset="0"
                  PreviewMouseWheel="OnRingChartPreviewMouseWheel">
                <!-- 半圆环图（0% 在 8 点钟，100% 在 4 点钟），中心数字点击可刷新，禁用内置 tooltip -->
                <controls:RingChartControl Width="38" Height="38"
                                            Percent="{Binding UsagePercentage, Mode=OneWay}"
                                            Size="38" StrokeThickness="4"
                                            TrackBrush="{DynamicResource TrackBrush}"
                                            ProgressBrush="{DynamicResource AccentBrush}"
                                            WarningBrush="{DynamicResource WarningBrush}"
                                            DangerBrush="{DynamicResource DangerBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,0,0,0"
                                            IsHalfRing="True"
                                            ShowHoverTooltip="False"
                                            EnabledMetrics="{Binding EnabledRingChartMetrics}"
                                            Tag="{Binding ProviderId}"
                                            CenterClick="OnRingChartCenterClick"
                                            MetricKeyChanged="OnRingChartMetricKeyChanged" />
            </Grid>
        </DataTemplate>

        <!-- 模板选择器，绑定到上面三种模板 -->
        <views:TaskbarItemTemplateSelector x:Key="TaskbarItemTemplateSelector"
                                            TextTemplate="{StaticResource TaskbarTextTemplate}"
                                            LineChartTemplate="{StaticResource TaskbarLineChartTemplate}"
                                            RingChartTemplate="{StaticResource TaskbarRingChartTemplate}" />
    </Window.Resources>

    <Border Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="8" Padding="12,6" Margin="2"
            BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1"
            x:Name="RootBorder">
        <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Padding="0">
                <ItemsControl ItemsSource="{Binding EnabledUsages, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource TaskbarItemTemplateSelector}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
