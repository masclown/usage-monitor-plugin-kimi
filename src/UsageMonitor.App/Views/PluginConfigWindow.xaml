<Window x:Class="UsageMonitor.App.Views.PluginConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="插件配置"
        Height="Auto" Width="520"
        SizeToContent="Height"
        MinWidth="440" MaxHeight="760"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="TitleText" Grid.Row="0"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="0,0,6,0">
            <StackPanel>
                <!-- 动态表单区域（代码根据 ConfigFields 填充） -->
                <StackPanel x:Name="FormPanel" />

                <!-- 卡片图表分组 -->
                <Separator Margin="0,8,0,14" />
                <TextBlock Text="卡片图表" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="选择在主窗口该服务商卡片中展示的图表类型（下方为示例预览）"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,8" TextWrapping="Wrap" />
                <ComboBox x:Name="CardChartCombo" Width="180" HorizontalAlignment="Left"
                          DisplayMemberPath="Value" SelectedValuePath="Key"
                          SelectionChanged="OnCardChartSelectionChanged" />

                <Border x:Name="CardChartPreviewHost" Height="160" Margin="0,12,0,0"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusSmall}" Padding="10" />
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="GetCookieButton" Content="🌐 获取登录态"
                    Margin="0,0,12,0" Click="OnGetCookieClick"
                    Style="{StaticResource GhostButtonStyle}"
                    Visibility="Collapsed"
                    ToolTip="自动启动独立 Edge 窗口并打开登录页，登录完成后自动获取 Cookie" />
            <Button Content="取消" Margin="0,0,12,0" Click="OnCancelClick"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button Content="保存" Click="OnSaveClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
