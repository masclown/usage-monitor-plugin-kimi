<Window x:Class="UsageMonitor.App.Views.PluginConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:UsageMonitor.App.Helpers"
        Title="{helpers:Loc pluginconfig.title}"
        Height="Auto" Width="520"
        SizeToContent="Height"
        MinWidth="440" MaxHeight="760"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题（req-069：绑定 VM.WindowTitle） -->
        <TextBlock Grid.Row="0"
                   Text="{Binding WindowTitle}"
                   FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="0,0,6,0">
            <StackPanel>
                <!-- 动态表单区域（代码根据 ConfigFields 填充） -->
                <StackPanel x:Name="FormPanel" />

                <!-- S6：卡片图表启用开关（按插件 defaults.json 声明的 Card.Charts 列出 chartId 开关；
                     数据落点与设置窗口【卡片管理】页同为 AccountCustomization.VisibleCharts） -->
                <StackPanel x:Name="CardChartSwitchSection">
                    <Separator Margin="0,8,0,14" />
                    <TextBlock Text="{helpers:Loc pluginconfig.charts.title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{helpers:Loc pluginconfig.charts.hint}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap" />
                    <!-- 开关容器：代码按插件声明的图表动态填充 CheckBox -->
                    <StackPanel x:Name="CardChartSwitchPanel" />
                </StackPanel>

                <!-- S6：任务栏迷你图表启用开关（按插件声明的 Taskbar.MiniCharts 列出 chartId 开关；
                     数据落点与设置窗口【任务栏迷你图表】页同为 AccountCustomization.VisibleMiniCharts） -->
                <StackPanel x:Name="MiniChartSwitchSection">
                    <Separator Margin="0,8,0,14" />
                    <TextBlock Text="{helpers:Loc pluginconfig.minicharts.title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{helpers:Loc pluginconfig.minicharts.hint}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap" />
                    <!-- 开关容器：代码按插件声明的迷你图表动态填充 CheckBox -->
                    <StackPanel x:Name="MiniChartSwitchPanel" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮（req-069：交互全部走 Command Binding） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <!-- req-079 U-30：emoji 按钮改为纯文字 + ToolTip；req-069：Content/IsEnabled/Visibility 绑定 VM 状态 -->
            <Button Content="{Binding GetCookieButtonText}"
                    Command="{Binding GetCookieCommand}"
                    IsEnabled="{Binding IsGetCookieEnabled}"
                    Visibility="{Binding HasLoginConfig, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,12,0"
                    Style="{StaticResource GhostButtonStyle}"
                    ToolTip="{helpers:Loc pluginconfig.getcookie.tip}" />
            <Button Content="{helpers:Loc common.cancel}" Margin="0,0,12,0" Command="{Binding CancelCommand}"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button Content="{helpers:Loc common.save}" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
