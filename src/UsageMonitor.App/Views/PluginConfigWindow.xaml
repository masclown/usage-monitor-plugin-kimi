<Window x:Class="UsageMonitor.App.Views.PluginConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:UsageMonitor.App.Helpers"
        Title="{helpers:Loc pluginconfig.title}"
        Height="Auto" Width="520"
        SizeToContent="Height"
        MinWidth="440" MaxHeight="760"
        Background="{DynamicResource AppBackgroundBrush}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock x:Name="TitleText" Grid.Row="0"
                   FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Margin="0,0,0,18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="0,0,6,0">
            <StackPanel>
                <!-- 动态表单区域（代码根据 ConfigFields 填充） -->
                <StackPanel x:Name="FormPanel" />

                <!-- req-109：账号管理（同 Provider 多账号 UI）
                     提供 + 添加账号 / 编辑昵称 / 使用昵称 / 删除账号
                     仅当 _configService 与 providerId 都有值时显示 -->
                <StackPanel x:Name="AccountSection">
                    <Separator Margin="0,8,0,14" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="账号" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="同一 Provider 支持多个账号（API / 订阅 / 测试号）。每账号独立卡片配置。"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="AddAccountButton" Grid.Column="1" Content="+ 添加账号" Click="OnAddAccountClick"
                                Style="{StaticResource AccentSoftButtonStyle}" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="AccountListPanel" />
                </StackPanel>

                <!-- 卡片图表分组（req-107 B6 收敛：插件声明的 SupportedCardCharts 已统一由 ChartKindExtractor 读取，优先 Card 声明的 Charts，回退旧属性） -->
                <StackPanel x:Name="CardChartSection">
                    <Separator Margin="0,8,0,14" />
                    <TextBlock Text="{helpers:Loc pluginconfig.cardchart.title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{helpers:Loc pluginconfig.cardchart.hint}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap" />
                    <!-- 复选框容器：代码根据插件支持的图表类型动态填充 -->
                    <StackPanel x:Name="CardChartCheckPanel" />

                    <!-- 预览区：垂直堆叠所有已勾选图表的示例 -->
                    <StackPanel x:Name="CardChartPreviewHost" Margin="0,12,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <!-- req-079 U-30：emoji 按钮改为纯文字 + ToolTip -->
            <Button x:Name="GetCookieButton" Content="{helpers:Loc pluginconfig.getcookie}"
                    Margin="0,0,12,0" Click="OnGetCookieClick"
                    Style="{StaticResource GhostButtonStyle}"
                    Visibility="Collapsed"
                    ToolTip="{helpers:Loc pluginconfig.getcookie.tip}" />
            <Button Content="{helpers:Loc common.cancel}" Margin="0,0,12,0" Click="OnCancelClick"
                    Style="{StaticResource GhostButtonStyle}" />
            <Button Content="{helpers:Loc common.save}" Click="OnSaveClick"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
