<Window x:Class="UsageMonitor.App.Views.TriggerAreaOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TriggerAreaOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        Width="{x:Static SystemParameters.PrimaryScreenWidth}"
        Height="{x:Static SystemParameters.PrimaryScreenHeight}">
    <!--
        触发区域调试矩形：屏幕右下角 1:1 还原当前 TrayTriggerWidth/TrayTriggerHeight，
        8 个 Thumb（4 边 + 4 角）支持拖拽调整边界，矩形本身在屏幕四角和边缘之外鼠标穿透。
    -->
    <Grid x:Name="RootGrid">
        <!-- 触发区域矩形：水平靠右、垂直靠底对齐；改 Width 时左边自动右移、改 Height 时上边自动下移 -->
        <Border x:Name="TriggerBorder"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,0,0"
                Background="#201E90FF"
                BorderBrush="#FF1E90FF"
                BorderThickness="2"
                Width="200" Height="40"
                IsHitTestVisible="True">
            <Grid IsHitTestVisible="True">
                <!-- 4 边中点：左右 6×20、上下 20×6 -->
                <Thumb x:Name="ThumbLeft" Tag="Left"
                       Width="6" Height="20"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Cursor="SizeWE" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbRight" Tag="Right"
                       Width="6" Height="20"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Cursor="SizeWE" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbTop" Tag="Top"
                       Width="20" Height="6"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Cursor="SizeNS" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbBottom" Tag="Bottom"
                       Width="20" Height="6"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Cursor="SizeNS" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <!-- 4 个角：10×10 -->
                <Thumb x:Name="ThumbTopLeft" Tag="TopLeft"
                       Width="10" Height="10"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Cursor="SizeNWSE" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbTopRight" Tag="TopRight"
                       Width="10" Height="10"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Cursor="SizeNESW" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbBottomLeft" Tag="BottomLeft"
                       Width="10" Height="10"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Cursor="SizeNESW" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbBottomRight" Tag="BottomRight"
                       Width="10" Height="10"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
            </Grid>
        </Border>
    </Grid>
</Window>
