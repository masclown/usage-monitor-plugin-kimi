<Window x:Class="UsageMonitor.App.Views.TriggerAreaOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TriggerAreaOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="True"
        IsHitTestVisible="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        Width="{x:Static SystemParameters.PrimaryScreenWidth}"
        Height="{x:Static SystemParameters.PrimaryScreenHeight}">
    <!--
        REQ-004：托盘悬浮窗触发区域调试矩形。整屏半透明灰色蒙版 + 当前 RectInt (X/Y/W/H) 边框 / 填充；
        8 个 Thumb（4 边 + 4 角）调整边界；蒙版整体可拖动；Esc 或点击蒙版空白退出；
        MouseUp 后 500ms 防抖写入 ConfigService.Settings.TrayTooltipTriggerRect → SettingsWindow XAML 双向同步。
    -->
    <Canvas x:Name="RootCanvas">
        <!-- 整屏灰色蒙版：用实际屏幕宽高，避免 WPF 当作按设计分辨率拉伸 -->
        <Rectangle x:Name="MaskLayer"
                   Fill="#80000000"
                   IsHitTestVisible="True"
                   Width="{Binding ActualWidth, ElementName=RootCanvas}"
                   Height="{Binding ActualHeight, ElementName=RootCanvas}"
                   MouseLeftButtonDown="OnMaskMouseLeftButtonDown" />

        <!-- 当前触发区域矩形：靠 X/Y 绝对位置（左上为原点）；大小由代码在 ApplyRect 中维护 -->
        <Border x:Name="TriggerBorder"
                Background="#201E90FF"
                BorderBrush="#FF1E90FF"
                BorderThickness="2"
                IsHitTestVisible="True"
                Canvas.Left="0" Canvas.Top="0"
                Width="240" Height="120"
                MouseLeftButtonDown="OnBorderMouseLeftButtonDown"
                MouseMove="OnBorderMouseMove"
                MouseLeftButtonUp="OnBorderMouseLeftButtonUp">
            <Grid IsHitTestVisible="True">
                <TextBlock x:Name="CoordsLabel"
                           Foreground="White"
                           FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="6,4,0,0"
                           IsHitTestVisible="False"
                           Text="X=0 Y=0 W=240 H=120" />

                <!-- 4 边中点 Thumb -->
                <Thumb x:Name="ThumbLeft" Tag="Left"
                       Width="6" Height="20"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Cursor="SizeWE" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbRight" Tag="Right"
                       Width="6" Height="20"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Cursor="SizeWE" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbTop" Tag="Top"
                       Width="20" Height="6"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Cursor="SizeNS" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbBottom" Tag="Bottom"
                       Width="20" Height="6"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Cursor="SizeNS" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <!-- 4 角 Thumb -->
                <Thumb x:Name="ThumbTopLeft" Tag="TopLeft"
                       Width="10" Height="10"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Cursor="SizeNWSE" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbTopRight" Tag="TopRight"
                       Width="10" Height="10"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Cursor="SizeNESW" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbBottomLeft" Tag="BottomLeft"
                       Width="10" Height="10"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Cursor="SizeNESW" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
                <Thumb x:Name="ThumbBottomRight" Tag="BottomRight"
                       Width="10" Height="10"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" Background="White" BorderBrush="#FF1E90FF" BorderThickness="1"
                       DragDelta="OnThumbDragDelta" />
            </Grid>
        </Border>
    </Canvas>
</Window>
