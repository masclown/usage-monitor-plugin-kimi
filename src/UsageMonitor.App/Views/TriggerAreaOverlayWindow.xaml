<Window x:Class="UsageMonitor.App.Views.TriggerAreaOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TriggerAreaOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="True"
        IsHitTestVisible="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        Left="{x:Static SystemParameters.VirtualScreenLeft}"
        Top="{x:Static SystemParameters.VirtualScreenTop}"
        Width="{x:Static SystemParameters.VirtualScreenWidth}"
        Height="{x:Static SystemParameters.VirtualScreenHeight}"
        KeyDown="OnWindowKeyDown">
    <!--
        REQ-004/006：托盘悬浮窗触发区域调试矩形。覆盖完整虚拟屏（含任务栏）+ 当前 RectInt (X/Y/W/H) 边框 / 填充；
        8 个 Thumb（4 边 + 4 角）按固定对侧基点调整边界；蒙版整体可拖动；Esc 或点击蒙版空白退出；
        MouseUp 后 500ms 防抖写入 ConfigService.Settings.TrayTooltipTriggerRect → SettingsWindow XAML 双向同步。
    -->
    <Window.Resources>
        <!-- req-080 U-36：抽取 ResizeThumbStyle 统一 8 个 Thumb 视觉属性 -->
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource OverlayHandleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OverlayHandleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>
    <Canvas x:Name="RootCanvas">
        <!-- 整屏灰色蒙版：用实际屏幕宽高，避免 WPF 当作按设计分辨率拉伸 -->
        <Rectangle x:Name="MaskLayer"
                   Fill="{DynamicResource OverlayMaskBrush}"
                   IsHitTestVisible="True"
                   Width="{Binding ActualWidth, ElementName=RootCanvas}"
                   Height="{Binding ActualHeight, ElementName=RootCanvas}"
                   MouseLeftButtonDown="OnMaskMouseLeftButtonDown" />

        <!-- req-080 U-38：顶部提示条 -->
        <Border Canvas.Left="0" Canvas.Top="0"
                Width="{Binding ActualWidth, ElementName=RootCanvas}"
                Background="#CC000000" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold"
                           Text="拖动调整触发区域" />
                <TextBlock Foreground="#99FFFFFF" FontSize="12" Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="按 Esc 取消 · 点击空白处确认" />
                <Button Content="取消" Margin="24,0,0,0" Padding="12,4"
                        Background="Transparent" Foreground="White"
                        BorderBrush="#66FFFFFF" BorderThickness="1"
                        Cursor="Hand"
                        Click="OnCancelClick" />
            </StackPanel>
        </Border>

        <!-- 当前触发区域矩形：靠 X/Y 绝对位置（左上为原点）；大小由代码在 ApplyRect 中维护 -->
        <Border x:Name="TriggerBorder"
                Background="{DynamicResource OverlayDebugFillBrush}"
                BorderBrush="{DynamicResource OverlayDebugBorderBrush}"
                BorderThickness="2"
                IsHitTestVisible="True"
                Canvas.Left="0" Canvas.Top="0"
                Width="240" Height="120"
                MouseLeftButtonDown="OnBorderMouseLeftButtonDown"
                MouseMove="OnBorderMouseMove"
                MouseLeftButtonUp="OnBorderMouseLeftButtonUp">
            <Grid IsHitTestVisible="True">
                <TextBlock x:Name="CoordsLabel"
                           Foreground="White"
                           FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Margin="6,4,0,0"
                           IsHitTestVisible="False"
                           Text="X=0 Y=0 W=240 H=120" />

                <!-- 4 边中点 Thumb：req-080 U-37 命中区扩大至 30x30，视觉仍 6x20 -->
                <Thumb x:Name="ThumbLeft" Tag="Left" Style="{StaticResource ResizeThumbStyle}"
                       Width="30" Height="30"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Cursor="SizeWE"
                       DragDelta="OnThumbDragDelta"
                       DragCompleted="OnThumbDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Width="30" Height="30" Background="Transparent">
                                <Rectangle Width="6" Height="20"
                                           Fill="{DynamicResource OverlayHandleBackgroundBrush}"
                                           Stroke="{DynamicResource OverlayHandleBorderBrush}"
                                           StrokeThickness="1" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Thumb x:Name="ThumbRight" Tag="Right" Style="{StaticResource ResizeThumbStyle}"
                       Width="30" Height="30"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Cursor="SizeWE"
                       DragDelta="OnThumbDragDelta"
                       DragCompleted="OnThumbDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Width="30" Height="30" Background="Transparent">
                                <Rectangle Width="6" Height="20"
                                           Fill="{DynamicResource OverlayHandleBackgroundBrush}"
                                           Stroke="{DynamicResource OverlayHandleBorderBrush}"
                                           StrokeThickness="1" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Thumb x:Name="ThumbTop" Tag="Top" Style="{StaticResource ResizeThumbStyle}"
                       Width="30" Height="30"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Cursor="SizeNS"
                       DragDelta="OnThumbDragDelta"
                       DragCompleted="OnThumbDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Width="30" Height="30" Background="Transparent">
                                <Rectangle Width="20" Height="6"
                                           Fill="{DynamicResource OverlayHandleBackgroundBrush}"
                                           Stroke="{DynamicResource OverlayHandleBorderBrush}"
                                           StrokeThickness="1" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Thumb x:Name="ThumbBottom" Tag="Bottom" Style="{StaticResource ResizeThumbStyle}"
                       Width="30" Height="30"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Cursor="SizeNS"
                       DragDelta="OnThumbDragDelta"
                       DragCompleted="OnThumbDragCompleted">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Width="30" Height="30" Background="Transparent">
                                <Rectangle Width="20" Height="6"
                                           Fill="{DynamicResource OverlayHandleBackgroundBrush}"
                                           Stroke="{DynamicResource OverlayHandleBorderBrush}"
                                           StrokeThickness="1" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <!-- 4 角 Thumb -->
                <Thumb x:Name="ThumbTopLeft" Tag="TopLeft" Style="{StaticResource ResizeThumbStyle}"
                       Width="10" Height="10"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Cursor="SizeNWSE"
                       DragDelta="OnThumbDragDelta"
                       DragCompleted="OnThumbDragCompleted" />
                <Thumb x:Name="ThumbTopRight" Tag="TopRight" Style="{StaticResource ResizeThumbStyle}"
                       Width="10" Height="10"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Cursor="SizeNESW"
                       DragDelta="OnThumbDragDelta"
                       DragCompleted="OnThumbDragCompleted" />
                <Thumb x:Name="ThumbBottomLeft" Tag="BottomLeft" Style="{StaticResource ResizeThumbStyle}"
                       Width="10" Height="10"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Cursor="SizeNESW"
                       DragDelta="OnThumbDragDelta"
                       DragCompleted="OnThumbDragCompleted" />
                <Thumb x:Name="ThumbBottomRight" Tag="BottomRight" Style="{StaticResource ResizeThumbStyle}"
                       Width="10" Height="10"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE"
                       DragDelta="OnThumbDragDelta"
                       DragCompleted="OnThumbDragCompleted" />
            </Grid>
        </Border>
    </Canvas>
</Window>
