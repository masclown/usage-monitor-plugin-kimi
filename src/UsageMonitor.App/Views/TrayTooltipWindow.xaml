<Window x:Class="UsageMonitor.App.Views.TrayTooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageMonitor Tray Tooltip"
        Width="320" Height="Auto"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="Height"
        Focusable="False"
        ShowActivated="False"
        IsHitTestVisible="True">
    <Border Background="#F21E1E2E" CornerRadius="8" Padding="0,4"
            BorderBrush="#FF3D3D52" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      MaxHeight="500"
                      Padding="0">
            <ItemsControl ItemsSource="{Binding Usages, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF2D2D3F"
                                CornerRadius="6" Padding="14,10" Margin="10,4">
                            <StackPanel>
                                <!-- 服务商名称和状态 -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#FFE2E8F0" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               Foreground="{Binding IsError, Converter={StaticResource ErrorColorConverter}}"
                                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- 进度条 -->
                                <Grid Height="6" Margin="0,0,0,10">
                                    <Border CornerRadius="3" Background="#FF3D3D52" />
                                    <Border CornerRadius="3" Background="#FF60A5FA"
                                            HorizontalAlignment="Left">
                                        <Border.Width>
                                            <Binding Path="UsagePercentage" Mode="OneWay"
                                                     Converter="{StaticResource PercentageToWidthConverter}"
                                                     ConverterParameter="280" />
                                        </Border.Width>
                                    </Border>
                                </Grid>

                                <!-- 详细信息 -->
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="已使用" FontSize="10"
                                                   Foreground="#FF94A3B8" />
                                        <TextBlock Text="{Binding UsedText}" FontSize="12"
                                                   Foreground="#FFE2E8F0"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="总额度" FontSize="10"
                                                   Foreground="#FF94A3B8" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="12"
                                                   Foreground="#FFE2E8F0"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="剩余额度" FontSize="10"
                                                   Foreground="#FF94A3B8" />
                                        <TextBlock Text="{Binding RemainingText}" FontSize="12"
                                                   Foreground="#FF16A34A"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- 错误信息 -->
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#FFDC2626"
                                           FontSize="11" TextWrapping="Wrap"
                                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
