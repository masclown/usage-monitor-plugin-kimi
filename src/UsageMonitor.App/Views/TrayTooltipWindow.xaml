<Window x:Class="UsageMonitor.App.Views.TrayTooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageMonitor Tray Tooltip"
        Width="330" Height="Auto"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="Height"
        Focusable="False"
        ShowActivated="False"
        IsHitTestVisible="True"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        Cursor="SizeAll">
    <Border Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="10" Padding="0,4"
            BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1"
            Cursor="SizeAll">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500" Padding="0">
            <ItemsControl ItemsSource="{Binding EnabledUsages, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="14,10" Margin="10,4">
                            <StackPanel>
                                <!-- 服务商名称和状态 -->
                                <DockPanel Margin="0,0,0,8">
                                    <!-- Provider Logo 图标 -->
                                    <Image Source="{Binding IconPath}" Width="18" Height="18"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IconPath, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               Foreground="{Binding IsError, Converter={StaticResource ErrorColorConverter}}"
                                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- 进度条（按用量阈值换色） -->
                                <Grid Height="7" Margin="0,0,0,10">
                                    <Border CornerRadius="4" Background="{DynamicResource TrackBrush}" />
                                    <Border CornerRadius="4"
                                            Background="{Binding UsagePercentage, Converter={StaticResource PercentToBrush}}"
                                            HorizontalAlignment="Left">
                                        <Border.Width>
                                            <Binding Path="UsagePercentage" Mode="OneWay"
                                                     Converter="{StaticResource PercentageToWidthConverter}"
                                                     ConverterParameter="290" />
                                        </Border.Width>
                                    </Border>
                                </Grid>

                                <!-- 详细信息 -->
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="已使用" FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding UsedText}" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="总额度" FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="剩余额度" FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding RemainingText}" FontSize="12"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- 错误信息 -->
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
