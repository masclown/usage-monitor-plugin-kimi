<Window x:Class="UsageMonitor.App.Views.TrayTooltipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageMonitor Tray Tooltip"
        Width="300" Height="Auto"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="Height"
        Focusable="False"
        ShowActivated="False"
        IsHitTestVisible="True"
        TextElement.FontFamily="{DynamicResource AppFontFamily}"
        Cursor="SizeAll">
    <Grid>
        <!-- req-036：右侧透明拖拽条。req-079 U-34：宽度 6→12px，hover 显示半透明色 -->
        <Rectangle x:Name="RightResizeGrip" Width="12" HorizontalAlignment="Right"
                   Fill="Transparent" Cursor="SizeWE"
                   ToolTip="拖动调整宽度">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" Value="#22FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>
        <Border Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="10" Padding="0,4"
                BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1"
                Cursor="SizeAll">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500" Padding="0">
            <ItemsControl ItemsSource="{Binding EnabledUsages, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                CornerRadius="{DynamicResource RadiusSmall}" Padding="14,10" Margin="10,4">
                            <StackPanel>
                                <!-- 服务商名称和状态 -->
                                <DockPanel Margin="0,0,0,8">
                                    <!-- Provider Logo 图标 -->
                                    <Image Source="{Binding IconPath}" Width="18" Height="18"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IconPath, Converter={StaticResource StringToVisibility}}" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               Foreground="{Binding IsError, Converter={StaticResource ErrorColorConverter}}"
                                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <!-- 进度条（按用量阈值换色） -->
                                <Grid x:Name="ProgressBarContainer" Height="7" Margin="0,0,0,10">
                                    <Border CornerRadius="4" Background="{DynamicResource TrackBrush}" />
                                    <Border CornerRadius="4"
                                            Background="{Binding UsagePercentage, Converter={StaticResource PercentToBrush}}"
                                            HorizontalAlignment="Left">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentAndWidthToProgressBarWidth}">
                                                <Binding Path="UsagePercentage" Mode="OneWay" />
                                                <Binding Path="ActualWidth" ElementName="ProgressBarContainer" Mode="OneWay" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>

                                <!-- 详细信息。req-079 U-35：标签字号 10→11，数值字号 12→13 -->
                                <UniformGrid Columns="3">
                                    <StackPanel>
                                        <TextBlock Text="已使用" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding UsedText}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="总额度" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="剩余额度" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock Text="{Binding RemainingText}" FontSize="13"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   FontWeight="Medium" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- req-028：5h 倒计时（字号与额度一致） -->
                                <TextBlock Text="{Binding FiveHourCountdownText}" FontSize="12" FontWeight="Medium"
                                           HorizontalAlignment="Right" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />

                                <!-- 错误信息 -->
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        </Border>
    </Grid>
</Window>
